---
import "@fontsource-variable/inter";
import "../styles/global.css";
import "../styles/devices.css";
import "../styles/v2.css";
import "../styles/screens.css";
import "../styles/home3.css";
import "../styles/how.css";
import Space from "../space/Space";
import { FOOTER, LEGAL_LINKS, LOGIN_URL, ROUTES, SITE, START_URL, UI, orgGraph, type Lang } from "../content/site";

interface Props {
  lang: Lang;
  /** Sidans sökväg på det här språket, t.ex. "/" eller "/pris/". */
  path: string;
  /** Samma sida på det andra språket – saknas den (landningssidorna) blir det ingen hreflang. */
  altPath?: string;
  title: string;
  description: string;
  /** Sektionerna snäpper (marknadssidorna). Text-, frågor- och avtalssidor snäpper inte. */
  snap?: boolean;
  /** Klotet i rymden (startsidan) – övriga sidor har bara stjärnorna. */
  orb?: boolean;
  /** Extra JSON-LD utöver Organization och WebSite. */
  schema?: Record<string, unknown>[];
  /** Delningsbild (absolut sökväg på sajten). */
  og?: string;
}
const { lang, path, altPath, title, description, snap = false, orb = false, schema = [], og } = Astro.props;
const ui = UI[lang];
const R = ROUTES[lang];
const canonical = `${SITE}${path}`;
const other = lang === "sv" ? "en" : "sv";
const switchHref = altPath ?? ROUTES[other].home;
const ogImage = `${SITE}${og ?? (lang === "sv" ? "/og.png" : "/og-en.png")}`;
const ld = { "@context": "https://schema.org", "@graph": [...orgGraph(lang), ...schema] };
const isCurrent = (href: string) => (path === href || path.startsWith(href) && href !== R.home ? "page" : undefined);
---

<!doctype html>
<html lang={lang} class={snap ? "snap" : undefined}>
  <head>
    <meta charset="utf-8" />
    <!-- Samtycke (Consent Mode v2): allt nekat. Det finns ingen samtyckesbanner, så Googles taggar sätter
         inga kakor och skickar bara kakfria signaler. Måste ligga före Google Tag Manager. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
      });
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5F29GCGQ');</script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      altPath && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={other} href={`${SITE}${altPath}`} />
          <link rel="alternate" hreflang="x-default" href={`${SITE}${lang === "sv" ? path : altPath}`} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Newstail" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "sv" ? "sv_SE" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5F29GCGQ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Space client:load orb={orb} />
    <header class="nav" id="nav">
      <div class="nav-inner">
        <a href={R.home} class="logo" aria-label="Newstail"></a>
        <nav class="nav-links" aria-label={ui.nav.menu}>
          <a href={R.how} aria-current={isCurrent(R.how)}>{ui.nav.how}</a>
          <a href={R.trust} aria-current={isCurrent(R.trust)}>{ui.nav.trust}</a>
          <a href={R.pricing} aria-current={isCurrent(R.pricing)}>{ui.nav.pricing}</a>
        </nav>
        <div class="nav-right">
          <a class="lang" href={switchHref} hreflang={other}>{ui.nav.switch}</a>
          <a class="pill pill-ghost nav-login" href={LOGIN_URL}>{ui.nav.login}</a>
          <a class="pill pill-primary nav-start" href={START_URL}>{ui.nav.start}</a>
          <button class="nav-menu-btn" type="button" aria-expanded="false" aria-controls="nav-sheet" aria-label={ui.nav.menu}>
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <nav class="nav-sheet" id="nav-sheet" aria-label={ui.nav.menu} inert>
        <a href={R.how}>{ui.nav.how}</a>
        <a href={R.trust}>{ui.nav.trust}</a>
        <a href={R.pricing}>{ui.nav.pricing}</a>
        <a href={R.about}>{ui.nav.about}</a>
        <div class="nav-sheet-foot">
          <a class="pill pill-primary pill-lg" href={START_URL}>{ui.nav.start}</a>
          <a class="pill pill-secondary pill-lg" href={LOGIN_URL}>{ui.nav.login}</a>
          <a class="nav-sheet-lang" href={switchHref} hreflang={other}>{ui.otherLang}</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer footer-v2" id="sidfot" data-space data-hue="262" data-orb="0.5,0.5,0.1,0" data-orb-m="0.5,0.5,0.1,0">
      <!-- Tyst sidfot (2026-10-26): logotyp, fyra länkar, språk och kontakt. Katalogen bakom "Mer". -->
      <div class="footer-quiet">
        <a href={R.home} class="logo" aria-label="Newstail"></a>
        <nav class="footer-main" aria-label={ui.nav.menu}>
          <a href={R.how}>{ui.nav.how}</a>
          <a href={R.trust}>{ui.nav.trust}</a>
          <a href={R.pricing}>{ui.nav.pricing}</a>
          <a href={R.about}>{ui.nav.about}</a>
        </nav>
        <a class="footer-lang" href={switchHref} hreflang={other}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.6 2.7 3.9 5.7 3.9 9s-1.3 6.3-3.9 9c-2.6-2.7-3.9-5.7-3.9-9S9.4 5.7 12 3z" /></svg>
          {ui.otherLang}
        </a>
        <a class="footer-mail" href="mailto:hello@newstail.io">hello@newstail.io</a>
      </div>
      <details class="footer-more">
        <summary>{ui.more}</summary>
        <div class={`footer-cols footer-cols-${FOOTER[lang].length}`}>
          {
            FOOTER[lang].map((col) => (
              <div class="footer-col">
                <h3><button type="button" aria-expanded="false">{col.t}</button></h3>
                <ul>
                  {col.links.map((l) => (
                    <li>
                      <a href={l.href}>{l.t}</a>
                    </li>
                  ))}
                </ul>
                {col.sub && (
                  <>
                    <h3 class="footer-sub">{col.sub.t}</h3>
                    <ul>
                      {col.sub.links.map((l) => (
                        <li>
                          <a href={l.href}>{l.t}</a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            ))
          }
        </div>
      </details>
      <div class="footer-foot">
        <span>{ui.legal}</span>
        {LEGAL_LINKS[lang].map((l) => <a href={l.href}>{l.t}</a>)}
      </div>
    </footer>
    <script>
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      if (!location.hash) window.scrollTo(0, 0);
      const nav = document.getElementById("nav");
      const menuBtn = document.querySelector<HTMLButtonElement>(".nav-menu-btn");
      const sheet = document.getElementById("nav-sheet");
      menuBtn?.addEventListener("click", () => {
        const open = menuBtn.getAttribute("aria-expanded") !== "true";
        menuBtn.setAttribute("aria-expanded", String(open));
        if (sheet) {
          sheet.classList.toggle("is-open", open);
          sheet.inert = !open;
        }
        nav?.classList.toggle("menu-open", open);
      });
      // Topplinjen: full högst upp, glider bort nedåt, kommer kompakt tillbaka uppåt.
      let lastY = window.scrollY;
      const onScroll = () => {
        const y = window.scrollY;
        const scrolled = y > 24;
        nav?.classList.toggle("is-scrolled", scrolled);
        if (nav && !nav.classList.contains("menu-open")) {
          const goingDown = y > lastY + 4;
          const goingUp = y < lastY - 4;
          if (!scrolled) nav.classList.remove("is-hidden");
          else if (goingDown) nav.classList.add("is-hidden");
          else if (goingUp) nav.classList.remove("is-hidden");
        }
        if (Math.abs(y - lastY) > 4) lastY = y;
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in-view");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.3 },
      );
      document.querySelectorAll("[data-watch]").forEach((el) => io.observe(el));
      // Sidfotens kolumner fälls ihop i mobilen (CSS döljer listorna under 760 px).
      document.querySelectorAll<HTMLButtonElement>(".footer-col h3 button").forEach((b) => {
        b.addEventListener("click", () => {
          const col = b.closest(".footer-col");
          const open = b.getAttribute("aria-expanded") !== "true";
          b.setAttribute("aria-expanded", String(open));
          col?.classList.toggle("is-open", open);
        });
      });
      // Enhetsramarna (telefonen, laptopen) är ritade i fasta pixlar och skalas till sin bredd.
      const devs = document.querySelectorAll<HTMLElement>(".dev");
      if (devs.length) {
        const ro = new ResizeObserver((entries) => {
          for (const e of entries) {
            const el = e.target as HTMLElement;
            el.style.setProperty("--s", String(e.contentRect.width / Number(el.style.getPropertyValue("--w") || 380)));
          }
        });
        devs.forEach((d) => ro.observe(d));
      }
    </script>
    <script is:inline>
      // Mätplan (2026-10-27): händelser till Google Tag Manager. Allt går via dataLayer, så GTM behöver
      // bara en utlösare och en GA4-tagg. Inga personuppgifter: FAQ-sökningens text skickas aldrig.
      (() => {
        const dl = (window.dataLayer = window.dataLayer || []);
        const send = (event, params) => dl.push({ event, page_path: location.pathname, ...params });
        const txt = (el) => (el.textContent || "").replace(/\s+/g, " ").trim().slice(0, 60);
        const placement = (el) => {
          if (el.closest(".nav-sheet")) return "meny";
          if (el.closest("header")) return "nav";
          if (el.closest("footer")) return "sidfot";
          const sec = el.closest("main section, body > section, section");
          if (!sec) return "ovrigt";
          const all = [...document.querySelectorAll("section")];
          const i = all.indexOf(sec);
          if (sec.matches(".closing") || i === all.length - 1) return "avslut";
          if (i === 0) return "hero";
          if (sec.querySelector("[data-calc]")) return "kalkylator";
          return sec.id || `sektion-${i + 1}`;
        };

        document.addEventListener("click", (e) => {
          const t = e.target instanceof Element ? e.target : null;
          if (!t) return;
          const a = t.closest("a[href]");
          if (a) {
            const href = a.getAttribute("href") || "";
            const p = { link_text: txt(a), placement: placement(a) };
            if (href.startsWith("https://air.newstail.io/start")) return send("prova_gratis_klick", p);
            if (href.startsWith("https://air.newstail.io/login")) return send("logga_in_klick", p);
            if (href.startsWith("mailto:")) return send("mejl_klick", p);
            if (a.matches(".lang")) return send("sprakbyte", { to_language: a.getAttribute("hreflang") || "" });
            return;
          }
          const b = t.closest("button");
          if (!b) return;
          if (b.hasAttribute("data-sample")) return send("rostprov_spela", { sample: b.getAttribute("data-sample") || "" });
          if (b.hasAttribute("data-cat")) return send("faq_filter", { category: txt(b) });
          let typ = "";
          if (b.closest("[data-quiz]")) typ = "quiz";
          else if (b.matches(".lang-tab")) typ = "sprak";
          else if (b.hasAttribute("data-flip-tab")) typ = "flik";
          else if (b.hasAttribute("data-ikapp-replay")) typ = "ikapp";
          else if (b.hasAttribute("data-i")) typ = "diagram";
          if (typ) send("demo_interaktion", { typ, value: txt(b) });
        });

        // FAQ: en fråga fälls ut av besökaren (toggle bubblar inte, därför capture). Frågor som är
        // öppna från början ger också toggle vid sidladdning, så bara klick på summary räknas.
        let lastSummary = null;
        document.addEventListener("pointerdown", (e) => { lastSummary = e.target instanceof Element ? e.target.closest("summary") : null; }, true);
        document.addEventListener("keydown", (e) => { lastSummary = e.target instanceof Element ? e.target.closest("summary") : null; }, true);
        document.addEventListener("toggle", (e) => {
          const d = e.target;
          if (!(d instanceof HTMLDetailsElement) || !d.open || d.matches(".footer-more")) return;
          if (!lastSummary || lastSummary.parentElement !== d) return;
          lastSummary = null;
          const s = d.querySelector("summary");
          send("faq_oppna", { question: s ? txt(s) : "" });
        }, true);

        // FAQ-sökning: bara att den används, aldrig vad som skrivs.
        let searched = false;
        document.addEventListener("input", (e) => {
          const el = e.target;
          if (!(el instanceof HTMLInputElement)) return;
          if (el.matches("[data-faq-search]") && !searched && el.value.length >= 3) {
            searched = true;
            send("faq_sok", {});
          }
          if (el.closest("[data-calc]")) {
            clearTimeout(el._t);
            el._t = setTimeout(() => send("pris_berakna", { users: Number(el.value) || 0 }), 1200);
          }
        });

        // Scrollscenen på startsidan: 25, 50, 75 och 100 % en gång var.
        const scen = document.getElementById("scen");
        if (scen) {
          const done = new Set();
          const check = () => {
            const r = scen.getBoundingClientRect();
            const span = r.height - innerHeight;
            if (span <= 0) return;
            const pct = Math.min(100, Math.max(0, (-r.top / span) * 100));
            for (const m of [25, 50, 75, 100]) if (pct >= m && !done.has(m)) { done.add(m); send("scen_framsteg", { percent: m }); }
          };
          addEventListener("scroll", check, { passive: true });
        }
      })();
    </script>
  </body>
</html>
