---
/**
 * Efteråt (2026-10-27): tre kort som kommer i tur och ordning när de syns – recapen med
 * källor, "Skicka vidare" till en kollega och quizen med rätt svar tänt.
 */
interface Props {
  lang: "sv" | "en";
}
const { lang } = Astro.props;
const sv = lang === "sv";
const t = sv
  ? {
      recap: "RECAP · RÄNTOR",
      title: "Marknaden räknar med sänkning före jul",
      text: "Bankerna räknar med en sänkning men inte hur stor. Det påverkar värderingarna inför bokslutet.",
      src: "2 källor · Näringsliv Idag, Morgonbladet",
      send: "SKICKA VIDARE · TILL EN KOLLEGA",
      to: "Till Johan",
      note: "Värt att ha med sig inför budgetmötet.",
      sent: "Johan hör det i sin nästa sändning",
      quiz: "QUIZ · DAGENS SÄNDNING",
      q: "Vad räknar marknaden med före jul?",
      opts: ["En höjning", "En sänkning", "Oförändrat"],
      right: "Rätt",
    }
  : {
      recap: "RECAP · RATES",
      title: "The market expects a cut before Christmas",
      text: "Banks expect a cut but not how big. It affects valuations ahead of year-end.",
      src: "2 sources · Näringsliv Idag, Morgonbladet",
      send: "SEND ON · TO A COLLEAGUE",
      to: "To Johan",
      note: "Worth having before the budget meeting.",
      sent: "Johan hears it in his next broadcast",
      quiz: "QUIZ · TODAY'S BROADCAST",
      q: "What does the market expect before Christmas?",
      opts: ["A rise", "A cut", "No change"],
      right: "Correct",
    };
---

<div class="after" data-watch role="img" aria-label={sv ? "Recap, skicka vidare och quiz" : "Recap, send on and quiz"}>
  <div class="after-card" style="--i: 0">
    <small class="after-k">{t.recap}</small>
    <b>{t.title}</b>
    <p>{t.text}</p>
    <span class="after-src">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7M21 3l-9 9M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
      {t.src}
    </span>
  </div>
  <div class="after-card after-send" style="--i: 1">
    <small class="after-k">{t.send}</small>
    <span class="after-to"><i><img src="/avatar-johan.webp" alt="" width="26" height="26" loading="lazy" decoding="async" /></i>{t.to}</span>
    <p>“{t.note}”</p>
    <span class="after-src after-ok">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
      {t.sent}
    </span>
  </div>
  <div class="after-card after-quiz" style="--i: 2">
    <small class="after-k">{t.quiz}</small>
    <b>{t.q}</b>
    <span class="after-opts">
      {t.opts.map((o, i) => (
        <span class={`after-opt${i === 1 ? " is-right" : ""}`}>
          {o}
          {i === 1 && <em>{t.right}</em>}
        </span>
      ))}
    </span>
  </div>
</div>
