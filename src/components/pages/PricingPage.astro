---
/** Pris: en plan, räknaren, hur betalningen går till, allt som ingår och frågorna. */
import FaqList from "../FaqList.astro";
import { faqFor } from "../../content/faq";
import { ROUTES, START_URL, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const faq = faqFor("pricing", lang);
const PRICE = sv ? 179 : 17;

const c = sv
  ? {
      h1: "Ett pris. Ingen bindning.",
      lead: "Ni bjuder in dem som ska vara med och betalar per användare. Minst tio användare.",
      plan: "Newstail",
      unit: "kr",
      per: "per användare och månad",
      checks: ["Allt ingår", "Minst tio användare", "Ingen bindningstid", "Ni ser beloppet innan det dras"],
      priceFacts: [["MINST", "10 användare"], ["PROVPERIOD", "14 dagar gratis"], ["BINDNING", "Ingen"], ["KORT UNDER PROVET", "Nej"], ["INGÅR", "Allt"]],
      cta: "Prova gratis i 14 dagar",
      fine: "Inget kort under provperioden. Priser exkl. moms. 17 € i övriga Europa, 18 $ i resten av världen.",
      payKicker: "Betalningen",
      payTitle: "Ni vet beloppet innan det dras.",
      steps: [
        ["Dag 1", "Hela företaget gratis", "14 dagar. Inget kort."],
        ["Dag 15", "Lägg in kort", "Första månaden dras i förskott."],
        ["Samma dag varje månad", "Antal användare × 179 kr", "Mejl tre dagar innan."],
      ],
      exampleL: "Exempel",
      exampleV: "34 användare → 6 086 kr i månaden",
      inclTitle: "Allt ingår.",
      incl: ["Obegränsat lyssnande", "En egen sändning per medarbetare", "Fyra språk", "Publicera med röst eller text", "Team och publiceringsrätter", "Recap och quiz", "Fredagsmejlet", "Admin med insikter"],
      faqTitle: "Frågor om priset.",
      big: "Volympris över 1 000 användare – hör av er",
    }
  : {
      h1: "One price. No lock-in.",
      lead: "You invite the people who should be in and pay per user. Ten users minimum.",
      plan: "Newstail",
      unit: "€",
      per: "per user and month",
      checks: ["Everything included", "Ten users minimum", "No lock-in", "You see the amount before it's charged"],
      priceFacts: [["MINIMUM", "10 users"], ["TRIAL", "14 days free"], ["LOCK-IN", "None"], ["CARD DURING TRIAL", "No"], ["INCLUDED", "Everything"]],
      cta: "Try it free for 14 days",
      fine: "No card during the trial. Prices excl. VAT. SEK 179 in Sweden, $18 outside Europe.",
      payKicker: "Payment",
      payTitle: "You know the amount before it's charged.",
      steps: [
        ["Day 1", "The whole company free", "14 days. No card."],
        ["Day 15", "Add a card", "The first month is charged in advance."],
        ["Same day every month", "Number of users × €17", "Email three days ahead."],
      ],
      exampleL: "Example",
      exampleV: "34 users → €578 a month",
      inclTitle: "Everything included.",
      incl: ["Unlimited listening", "A broadcast for every employee", "Four languages", "Publish by voice or text", "Teams and publishing rights", "Recap and quiz", "The Friday email", "Admin with insights"],
      faqTitle: "Questions about pricing.",
      big: "Volume pricing above 1,000 users – talk to us",
    };
const REST = "0.5,0.5,0.1,0";
---

<section class="section sub-top price-hero" data-space data-hue="200" data-orb={REST} data-watch>
  <div class="split how-split">
    <div class="split-text stack">
      <h1 class="title-hero">{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="actions">
        <a class="pill pill-primary pill-lg" href={START_URL}>{c.cta}</a>
      </div>
      <p class="note">{c.fine}</p>
    </div>
    <div class="split-stage how-stage">
      <dl class="facts price-facts">
        <div class="fact fact-big">
          <dt class="how-mono">{c.per.toUpperCase()}</dt>
          <dd>{sv ? `${PRICE} kr` : `€${PRICE}`}</dd>
        </div>
        {c.priceFacts.map(([k, v]) => (
          <div class="fact">
            <dt class="how-mono">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
<section class="section" data-space data-hue="72" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.payTitle}</h2>
    </div>
    <div class="timeline">
      {c.steps.map(([w, t, d], i) => (
        <div>
          <i class={i === 0 ? "on" : undefined} />
          <small>{w}</small>
          <b>{t}</b>
          <span>{d}</span>
        </div>
      ))}
    </div>
    <div class="example"><small>{c.exampleL}</small><span>{c.exampleV}</span></div>
  </div>
</section>

<section class="section" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.inclTitle}</h2>
    </div>
    <div class="grid-4">
      {c.incl.map((x) => <div class="lined"><strong>{x}</strong></div>)}
    </div>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{ui.startLong}</a>
    </div>
    <p class="note">{ui.noCard}</p>
  </div>
</section>

<section class="section" id={sv ? "fragor" : "questions"} data-space data-hue="200" data-orb={REST} data-watch>
  <div class="faq-split">
    <div class="stack">
      <h2 class="title-xl">{c.faqTitle}</h2>
      <a class="link-more" href={R.faq}>{ui.allQuestions}</a>
      <a class="link-more" href="mailto:hello@newstail.io" style="margin-top: 0.8rem">{c.big}</a>
    </div>
    <FaqList items={faq} lang={lang} />
  </div>
</section>

