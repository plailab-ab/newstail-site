      { topic: "NHL", title: "Boone Jenner nominated for the Bill Masterton Memorial Trophy", src: "Sportfanziner · Morgonbladet", hue: 150 },
      { topic: "INTERNAL · NORDVIK", title: "New office space ready by the new year", src: "Anna Lindqvist, CEO", hue: 72, inside: true },
    ];
const bubbles = sv
  ? [
