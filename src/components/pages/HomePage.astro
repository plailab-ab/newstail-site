---
/**
 * Startsidan = UPPLEVELSEN (2026-10-28): heron med klotet och svävande källetiketter, scenen
 * (klotet in i telefonen), språken som ljudstaplar, det interna (telefon med flytande kort),
 * efteråt som tre kort, ledningens kort, frågor, avslut. Problemet och tekniken berättas på
 * Så funkar det ("under huven"), integriteten på Trygghet – startsidan upprepar dem inte.
 * Klotet är fritt i heron, bor i telefonen i scenen och tonar sedan bort.
 * Inget snäpp. Scenen är fäst medan man scrollar (data-scene nedan).
 */
import Phone from "../air/Phone.astro";
import ScreenScene from "../air/ScreenScene.astro";
import ScreenPublish from "../air/ScreenPublish.astro";
import AdminCard from "../air/AdminCard.astro";
import LangWaves from "../home/LangWaves.astro";
import After from "../home/After.astro";
import FaqList from "../FaqList.astro";
import { faqFor } from "../../content/faq";
import { ROUTES, START_URL, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const REST = "0.5,0.5,0.1,0";

const c = sv
  ? {
      h1: "En egen nyhetssändning för varje medarbetare.",
      lead: "Internt, branschen och personliga intressen – uppläst på det språk var och en väljer.",
      scene: {
        greeting: "Hej Anna.",
        date: "Torsdag 23 oktober",
        steps: [
          { k: "HEMVYN", t: "Dagens spellista står klar när du är det.", d: "Tre till tio minuter med de viktigaste nyheterna för just dig." },
          { k: "DRAGET", t: "Dra upp. Lyssna.", d: "Klotet lyfter och värden börjar berätta." },
          { k: "SÄNDNINGEN", t: "Håll inne klotet, så går värden djupare.", d: "Svep för nästa. Tryck för paus." },
          { k: "INTERNT", t: "Det interna först.", d: "Före branschen. Före allt annat." },
        ],
      },
      langTitle: "Alla hänger med. På sitt språk.",
