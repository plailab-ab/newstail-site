---
/**
 * Startsidan "En sändning" (2026-10-26): en telefon och ett klot bär hela historien.
 * 1 heron (bara klotet) · 2 scenen – fäst medan man scrollar: klotet flyger in i telefonen,
 * dras upp, sändningen spelar, och tonar bort när scenen lämnar · 3 språket (samma nyhet på
 * fyra språk i telefonen) · 4 internt · 5 recap + quiz · 6 ledningen · 7 frågor · 8 avslut.
 * Klotet är fritt bara i heron; sedan bor det i telefonen. Inget snäpp, hela telefoner.
 */
import Phone from "../air/Phone.astro";
import ScreenScene from "../air/ScreenScene.astro";
import ScreenLang from "../air/ScreenLang.astro";
import ScreenPublish from "../air/ScreenPublish.astro";
import ScreenRecap from "../air/ScreenRecap.astro";
import ScreenQuiz from "../air/ScreenQuiz.astro";
import AdminCard from "../air/AdminCard.astro";
import FaqList from "../FaqList.astro";
import IconRow from "../IconRow.astro";
import { faqFor } from "../../content/faq";
import { ROUTES, START_URL, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const REST = "0.5,0.5,0.1,0";

const c = sv
  ? {
      h1: "En egen nyhetssändning för varje medarbetare.",
      lead: "Internt, branschen och egna intressen – uppläst på det språk var och en väljer.",
      scene: {
        greeting: "Hej Anna.",
        date: "Torsdag 23 oktober",
        steps: [
          { t: "Dagens lista står klar när du är det.", d: "Tre till tio minuter. Det du redan hört hoppas över." },
          { t: "Dra upp. Lyssna.", d: "Klotet lyfter och värden börjar berätta." },
          { t: "Håll klotet, så berättar värden mer.", d: "Svep för nästa. Tryck för paus." },
          { t: "Det interna först.", d: "Före branschen. Före allt annat." },
        ],
      },
      langTitle: "Alla hänger med. På sitt språk.",
      langIcons: [["globe", "Fyra språk"], ["headphones", "Samma sändning"], ["person", "Var och en väljer"]],
      langHeading: "Samma nyhet.",
      langSamples: [
        { code: "SV", name: "Svenska", lead: "Värden talar det språk du väljer.", title: "Hyresförhandlingen för 2027 är klar" },
        { code: "EN", name: "English", lead: "The host speaks the language you choose.", title: "The 2027 rent negotiation is done" },
        { code: "DE", name: "Deutsch", lead: "Der Moderator spricht die Sprache, die du wählst.", title: "Die Mietverhandlung für 2027 ist abgeschlossen" },
        { code: "ES", name: "Español", lead: "El presentador habla el idioma que tú eliges.", title: "La negociación del alquiler para 2027 está cerrada" },
      ],
      inTitle: "Säg det en gång. Vi läser upp det.",
      inIcons: [["mic", "Tala in"], ["pen", "Eller skriv"], ["eye", "Se vilka som hört"]],
      inTeams: ["Alla", "Ledning", "Sälj", "Produktion"],
      inFloat: "Vi förvärvar två fastigheter i centrala Växjö",
      inHeard: "har hört det",
      recTitle: "Gå djupare. Minns mer.",
      recIcons: [["doc", "Recap med källor"], ["share", "Skicka vidare"], ["check", "Kort quiz"]],
      recTabs: ["Recap", "Quiz"],
      leadTitle: "Se att det når fram.",
      leadIcons: [["team", "Per team"], ["lock", "Aldrig per person"], ["mail", "Veckans mejl"]],
      leadLink: "Vad ledningen ser",
      faqTitle: "Vanliga frågor.",
      endTitle: "Kom igång i dag.",
      endLead: "14 dagar gratis. Inget kort.",
      endPrice: "Se priser",
    }
  : {
      h1: "A personal news broadcast for every employee.",
      lead: "Internal news, the industry and personal interests – read out in the language each person chooses.",
      scene: {
        greeting: "Hi Anna.",
        date: "Thursday 23 October",
        steps: [
          { t: "Today's list is ready when you are.", d: "Three to ten minutes. Anything you've already heard is skipped." },
          { t: "Pull up. Listen.", d: "The orb rises and the host starts talking." },
          { t: "Hold the orb and the host tells you more.", d: "Swipe for next. Tap to pause." },
          { t: "Internal first.", d: "Before the industry. Before everything else." },
        ],
      },
      langTitle: "Everyone keeps up. In their language.",
      langIcons: [["globe", "Four languages"], ["headphones", "Same broadcast"], ["person", "Everyone chooses"]],
      langHeading: "Same story.",
      langSamples: [
        { code: "EN", name: "English", lead: "The host speaks the language you choose.", title: "The 2027 rent negotiation is done" },
        { code: "SV", name: "Svenska", lead: "Värden talar det språk du väljer.", title: "Hyresförhandlingen för 2027 är klar" },
        { code: "DE", name: "Deutsch", lead: "Der Moderator spricht die Sprache, die du wählst.", title: "Die Mietverhandlung für 2027 ist abgeschlossen" },
        { code: "ES", name: "Español", lead: "El presentador habla el idioma que tú eliges.", title: "La negociación del alquiler para 2027 está cerrada" },
      ],
      inTitle: "Say it once. We read it out.",
      inIcons: [["mic", "Record"], ["pen", "Or type"], ["eye", "See who heard it"]],
      inTeams: ["Everyone", "Management", "Sales", "Production"],
      inFloat: "We are acquiring two properties in central Växjö",
      inHeard: "have heard it",
      recTitle: "Go deeper. Remember more.",
      recIcons: [["doc", "Recap with sources"], ["share", "Send it on"], ["check", "Short quiz"]],
      recTabs: ["Recap", "Quiz"],
      leadTitle: "See that it gets through.",
      leadIcons: [["team", "Per team"], ["lock", "Never per person"], ["mail", "Weekly email"]],
      leadLink: "What management sees",
      faqTitle: "Common questions.",
      endTitle: "Get started today.",
      endLead: "14 days free. No card.",
      endPrice: "See pricing",
    };

const sceneItems = sv
  ? [
      { topic: "RÄNTOR", title: "Marknaden räknar med sänkning före jul", src: "Dagens industri · SvD", hue: 150 },
      { topic: "BRANSCH", title: "Vakanserna minskar i Smålands kontorsmarknad", src: "Fastighetsvärlden", hue: 200 },
      { topic: "INTERNT", title: "Hyresförhandlingen för 2027 är klar", src: "Anna Lindqvist", hue: 72, inside: true },
    ]
  : [
      { topic: "RATES", title: "The market expects a cut before Christmas", src: "Dagens industri · SvD", hue: 150 },
      { topic: "INDUSTRY", title: "Fewer empty offices in Småland", src: "Fastighetsvärlden", hue: 200 },
      { topic: "INTERNAL", title: "The 2027 rent negotiation is done", src: "Anna Lindqvist", hue: 72, inside: true },
    ];
const bubbles = sv
  ? [
      { label: "Internt", kind: "inside" as const, title: "Hyresförhandlingen för 2027 är klar" },
      { label: "Bransch", kind: "industry" as const, title: "Hyror upp 3,2 % i Småland" },
      { label: "Räntor", kind: "own" as const, title: "Marknaden räknar med sänkning före jul" },
      { label: "Bransch", kind: "industry" as const, title: "Vakanserna minskar i Småland" },
      { label: "Något nytt", kind: "surprise" as const, title: "Nya energikrav från årsskiftet" },
    ]
  : [
      { label: "Internal", kind: "inside" as const, title: "The 2027 rent negotiation is done" },
      { label: "Industry", kind: "industry" as const, title: "Rents up 3.2 % in Småland" },
      { label: "Rates", kind: "own" as const, title: "The market expects a cut before Christmas" },
      { label: "Industry", kind: "industry" as const, title: "Fewer empty offices in Småland" },
      { label: "Something new", kind: "surprise" as const, title: "New energy rules from the new year" },
    ];
const recap = sv
  ? {
      date: "IDAG",
      send: "Skicka vidare",
      share: "Dela",
      items: [
        { title: "Hyresförhandlingen för 2027 är klar", text: "Hyrorna höjs med 3,1 % i snitt från januari. Förvaltarna får underlaget i veckan.", src: "", inside: true },
        { title: "Marknaden räknar med sänkning före jul", text: "Bankerna räknar med en sänkning men inte hur stor. Det påverkar värderingarna inför bokslutet.", src: "Dagens industri" },
      ],
      follow: [
        { topic: "Energikrav", why: "Ur det du hört" },
        { topic: "Bostadsmarknaden", why: "Flera kollegor följer" },
      ],
    }
  : {
      date: "TODAY",
      send: "Send on",
      share: "Share",
      items: [
        { title: "The 2027 rent negotiation is done", text: "Rents rise 3.1 % on average from January. Property managers get the material this week.", src: "", inside: true },
        { title: "The market expects a cut before Christmas", text: "Banks expect a cut but not how big. It affects valuations ahead of year-end.", src: "Dagens industri" },
      ],
      follow: [
        { topic: "Energy rules", why: "From what you heard" },
        { topic: "Housing market", why: "Several colleagues follow" },
      ],
    };
const quiz = sv
  ? { close: "Stäng", q: "Hur mycket höjs hyrorna i snitt 2027?", options: ["2,4 %", "3,1 %", "4,0 %"], answer: 1, right: "Rätt!", wrong: "Inte riktigt", explain: "Förhandlingen landade på 3,1 % i snitt från januari – det var dagens interna nyhet." }
  : { close: "Close", q: "How much do rents rise on average in 2027?", options: ["2.4 %", "3.1 %", "4.0 %"], answer: 1, right: "Correct!", wrong: "Not quite", explain: "The negotiation landed on 3.1 % on average from January – that was today's internal news." };
const publish = sv
  ? { head: "NORDVIK", eyebrow: "NY INTERN NYHET", title: "Vad vill du berätta?", hint: "Tryck på klotet för att börja spela in.", write: "Skriv istället", published: "Publicerat" }
  : { head: "NORDVIK", eyebrow: "NEW INTERNAL NEWS", title: "What do you want to say?", hint: "Tap the orb to start recording.", write: "Type instead", published: "Published" };
const faq = faqFor("home", lang).slice(0, 4);
---

<!-- 1. Hero: bara klotet -->
<section class="section hero hero-v3" data-space data-hue="72" data-watch>
  <div class="hero-v3-inner">
    <div class="stage-hero hero-v3-stage">
      <div class="orb-anchor" data-orb-anchor></div>
    </div>
    <div class="hero-v3-text stack">
      <h1 class="title-hero">{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="actions">
        <a class="pill pill-primary pill-lg" href={START_URL}>{ui.start}</a>
        <a class="link-more" href={R.how}>{ui.nav.how}</a>
      </div>
    </div>
  </div>
</section>

<!-- 2. Scenen: klotet in i telefonen, dra upp, sändningen -->
<section class="scene" id="scen" data-space data-hue="262" data-scene data-watch>
  <div class="scene-pin">
    <div class="scene-steps" aria-live="polite">
      {c.scene.steps.map((s, i) => (
        <div class={`scene-step${i === 0 ? " is-on" : ""}`} data-step={i}>
          <h2 class="title-xl">{s.t}</h2>
          <p class="lead">{s.d}</p>
        </div>
      ))}
      <ol class="scene-progress" aria-hidden="true">
        {c.scene.steps.map((_, i) => <li class={i === 0 ? "is-on" : ""} data-prog={i}></li>)}
      </ol>
    </div>
    <div class="scene-stage">
      <Phone clear class="scene-phone" label={sv ? "Newstail-appen: från hemvyn till sändningen" : "The Newstail app: from home to the broadcast"}>
        <ScreenScene company="NORDVIK" greeting={c.scene.greeting} date={c.scene.date} bubbles={bubbles} items={sceneItems} done={sv ? "Avsluta" : "End"} />
      </Phone>
    </div>
  </div>
</section>

<!-- 3. Språket -->
<section class="section" id="sprak" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="split lang-split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.langTitle}</h2>
      <p class="lead" data-lang-lead>{c.langSamples[0]!.lead}</p>
      <div class="lang-row" role="tablist">
        {c.langSamples.map((x, i) => (
          <button type="button" class={`lang-tab${i === 0 ? " is-on" : ""}`} role="tab" aria-selected={i === 0 ? "true" : "false"} data-i={i}>{x.code}</button>
        ))}
      </div>
      <IconRow items={c.langIcons as any} />
      <script type="application/json" data-lang-samples set:html={JSON.stringify(c.langSamples.map((x) => x.lead))} />
    </div>
    <div class="split-stage stage-device">
      <Phone label={sv ? "Samma interna nyhet på fyra språk i Newstail-appen" : "The same internal story in four languages in the Newstail app"}>
        <ScreenLang company="NORDVIK" heading={c.langHeading} items={c.langSamples} />
      </Phone>
    </div>
  </div>
</section>

<!-- 4. Interninfo -->
<section class="section section-center" id="inside" data-space data-hue="72" data-orb={REST} data-watch>
  <div class="center-wrap">
    <div class="stack center-head">
      <h2 class="title-xl">{c.inTitle}</h2>
      <IconRow items={c.inIcons as any} class="icon-row-center" />
    </div>
    <div class="center-stage stage-device stage-glow" style="--glow-hue: 80">
      <Phone label={sv ? "Publicera i Newstail-appen" : "Publishing in the Newstail app"}>
        <ScreenPublish t={publish} />
      </Phone>
      <div class="floater floater-inside hide-m" style="left: 0; top: 26%"><small>{sv ? "Internt" : "Internal"}</small>{c.inFloat}</div>
      <div class="floater hide-m" style="right: 0; bottom: 22%"><b>38 {sv ? "av" : "of"} 41</b><small>{c.inHeard}</small></div>
      <div class="floater floater-teams hide-m" aria-hidden="true" style="right: 0; top: 22%">
        <small>{sv ? "Vilka som hör det" : "Who hears it"}</small>
        <span class="chips">{c.inTeams.map((t, i) => <span class={`chip${i === 0 ? " chip-on" : ""}`}>{t}</span>)}</span>
      </div>
    </div>
  </div>
</section>

<!-- 5. Recap + quiz -->
<section class="section" id="recap" data-space data-hue="300" data-orb={REST} data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <h2 class="title-xl">{c.recTitle}</h2>
      <IconRow items={c.recIcons as any} />
      <div class="flip-tabs" role="tablist">
        {c.recTabs.map((t, i) => <button type="button" class={`flip-tab${i === 0 ? " is-on" : ""}`} role="tab" aria-selected={i === 0 ? "true" : "false"} data-flip-tab={i}>{t}</button>)}
      </div>
    </div>
    <div class="split-stage stage-device stage-flip" data-flip>
      <Phone label={sv ? "Recapen och quizen i Newstail-appen" : "The recap and quiz in the Newstail app"}>
        <div class="scr-flip">
          <ScreenRecap lang={lang} {...recap} />
          <ScreenQuiz t={quiz} />
        </div>
      </Phone>
    </div>
  </div>
</section>

<!-- 6. Ledningen -->
<section class="section section-lead" id="ledare" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="lead-wrap">
    <div class="stack lead-head">
      <h2 class="title-xl">{c.leadTitle}</h2>
      <IconRow items={c.leadIcons as any} class="icon-row-center" />
      <a class="link-more" href={`${R.trust}${lang === "sv" ? "#ser" : "#sees"}`}>{c.leadLink}</a>
    </div>
    <div class="lead-stage">
      <AdminCard lang={lang} />
      <p class="note">{ui.demoNote}</p>
    </div>
  </div>
</section>

<!-- 7. Frågor -->
<section class="section" id="fragor" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="faq-split">
    <div class="stack">
      <h2 class="title-xl">{c.faqTitle}</h2>
      <a class="link-more" href={R.faq}>{ui.allQuestions}</a>
    </div>
    <FaqList items={faq} lang={lang} openFirst={false} />
  </div>
</section>

<!-- 8. Avslut -->
<section class="section closing" data-space data-hue="200" data-orb={REST} data-watch>
  <div class="stack closing-text">
    <h2 class="title-xl">{c.endTitle}</h2>
    <p class="lead">{c.endLead}</p>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{ui.start}</a>
      <a class="pill pill-secondary pill-lg" href={R.pricing}>{c.endPrice}</a>
    </div>
  </div>
</section>

<script>
  const w = window as unknown as { __orbKick?: number; __voiceAmp: number };
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const kick = () => {
    w.__orbKick = (w.__orbKick ?? 0) + 1;
  };

  // Heron: klotet byter färg som när värden går mellan nyheterna (internt, bransch, eget).
  const hero = document.querySelector<HTMLElement>(".hero");
  if (hero) {
    const HUES = [72, 150, 350];
    let i = 0;
    let timer = 0;
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => {
        i = (i + 1) % HUES.length;
        hero.dataset.hue = String(HUES[i]);
        kick();
      }, 12000);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(hero);
  }

  // Scenen: scrollen är tidslinjen. p = hur långt in i sektionen man är (0–1).
  //   0–0.2 hemvyn · 0.2–0.36 draget (klotet lyfter) · 0.36–0.56 punkt 1 · 0.56–0.72 punkt 2 · 0.72–1 interna (äger sista tredjedelen).
  const scene = document.querySelector<HTMLElement>("[data-scene]");
  if (scene) {
    const steps = [...scene.querySelectorAll<HTMLElement>("[data-step]")];
    const prog = [...scene.querySelectorAll<HTMLElement>("[data-prog]")];
    const caps = [...scene.querySelectorAll<HTMLElement>("[data-cap]")];
    const dots = [...scene.querySelectorAll<HTMLElement>("[data-dot]")];
    const phone = scene.querySelector<HTMLElement>(".scene-phone")!;
    const anchor = scene.querySelector<HTMLElement>(".sc-anchor")!;
    const rail = scene.querySelector<HTMLElement>(".sc-rail-line")!;
    const arc = scene.querySelector<HTMLElement>(".scr-ring-arc")!;
    let lastRise = "";
    let lastRing = "";
    let lastEnter = "";
    const setRise = (v: string) => {
      if (v === lastRise) return;
      lastRise = v;
      anchor.style.setProperty("--rise", v);
      rail.style.setProperty("--rise", v);
    };
    const setRing = (v: string) => {
      if (v === lastRing) return;
      lastRing = v;
      arc.style.setProperty("--ring", v);
    };
    const HUES = [150, 200, 72];
    const REST_HUE = 262;
    let state = "";
    let item = -1;
    let step = -1;
    const ease = (x: number) => x * x * (3 - 2 * x);
    const clamp = (x: number) => Math.min(1, Math.max(0, x));
    const setState = (s: string) => {
      if (s === state) return;
      state = s;
      scene.classList.toggle("s-home", s === "home");
      scene.classList.toggle("s-drag", s === "drag");
      scene.classList.toggle("s-play", s === "play");
    };
    const setItem = (k: number) => {
      if (k === item) return;
      const changed = item !== -1;
      item = k;
      caps.forEach((c, j) => c.classList.toggle("is-on", j === k));
      dots.forEach((d, j) => {
        d.classList.toggle("is-on", j === k);
        d.classList.toggle("is-done", j < k);
      });
      scene.dataset.hue = String(k < 0 ? REST_HUE : HUES[k]);
      if (changed || k >= 0) kick();
    };
    const setStep = (k: number) => {
      if (k === step) return;
      step = k;
      steps.forEach((s, j) => s.classList.toggle("is-on", j === k));
      prog.forEach((s, j) => s.classList.toggle("is-on", j <= k));
    };
    let raf = 0;
    const update = () => {
      raf = 0;
      const b = scene.getBoundingClientRect();
      const H = window.innerHeight;
      const total = Math.max(1, b.height - H);
      const p = clamp(-b.top / total);
      // Telefonen anländer: lutad och lite mindre innan sektionen fäster.
      const enter = clamp((H - b.top) / (H * 0.9)).toFixed(3);
      if (enter !== lastEnter) {
        lastEnter = enter;
        phone.style.setProperty("--enter", enter);
      }
      if (p < 0.2) {
        setState("home");
        setRise("0");
        setRing("0");
        setItem(-1);
        setStep(0);
      } else if (p < 0.36) {
        setState("drag");
        const u = ease(clamp((p - 0.2) / 0.16));
        setRise(u.toFixed(3));
        setRing("0");
        setItem(-1);
        setStep(1);
      } else {
        setState("play");
        setRise("1");
        // Tre punkter: de två yttre delar 0.36–0.72, den interna äger 0.72–1.
        const B = [0.36, 0.56, 0.72, 1.0];
        const k = p < B[1]! ? 0 : p < B[2]! ? 1 : 2;
        const ring = clamp((p - B[k]!) / (B[k + 1]! - B[k]!));
        setRing((ring * 100).toFixed(1));
        setItem(k);
        setStep(k === 0 ? (ring < 0.45 ? 1 : 2) : k === 1 ? 2 : 3);
      }
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }

  // Språket: bubblorna i telefonen tänds en i taget av sig själva; texten utanför byts bara
  // när någon trycker på en flik (då stannar växlingen).
  const langSec = document.getElementById("sprak");
  const samplesEl = langSec?.querySelector<HTMLScriptElement>("[data-lang-samples]");
  if (langSec && samplesEl) {
    const leads = JSON.parse(samplesEl.textContent || "[]") as string[];
    const lead = langSec.querySelector<HTMLElement>("[data-lang-lead]")!;
    const tabs = [...langSec.querySelectorAll<HTMLElement>(".lang-tab")];
    const bubbles = [...langSec.querySelectorAll<HTMLElement>("[data-lang-b]")];
    let i = 0;
    let timer = 0;
    const light = (k: number) => {
      i = k;
      bubbles.forEach((b, j) => b.classList.toggle("is-on", j === k));
    };
    const show = (k: number) => {
      light(k);
      lead.classList.add("is-switching");
      window.setTimeout(() => {
        lead.textContent = leads[k] ?? "";
        lead.classList.remove("is-switching");
      }, 220);
      tabs.forEach((t, j) => {
        t.classList.toggle("is-on", j === k);
        t.setAttribute("aria-selected", j === k ? "true" : "false");
      });
    };
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => light((i + 1) % bubbles.length), 3000);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(langSec);
    tabs.forEach((t, k) =>
      t.addEventListener("click", () => {
        stop();
        show(k);
      }),
    );
  }

  // Recap och quiz i samma telefon: flikarna byter, och den växlar själv tills någon klickar.
  const recapSec = document.getElementById("recap");
  if (recapSec) {
    const flip = recapSec.querySelector<HTMLElement>(".scr-flip")!;
    const tabs = [...recapSec.querySelectorAll<HTMLButtonElement>("[data-flip-tab]")];
    let i = 0;
    let timer = 0;
    const show = (k: number) => {
      i = k;
      flip.classList.toggle("is-quiz", k === 1);
      tabs.forEach((t, j) => {
        t.classList.toggle("is-on", j === k);
        t.setAttribute("aria-selected", j === k ? "true" : "false");
      });
    };
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => show((i + 1) % 2), 8000);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    tabs.forEach((t, k) =>
      t.addEventListener("click", () => {
        stop();
        show(k);
      }),
    );
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(recapSec);
  }
</script>
