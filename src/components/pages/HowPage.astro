---
/**
 * Så funkar det (2026-10-27, "under huven"): startsidan säljer känslan, den här sidan ger
 * förtroendet. Problemet (bruset) → vi lyssnar på allt → vaskar fram det som är ert (stapeln)
 * → det interna som ingen läser → det du själv brinner för → och allt det blir ett svep
 * (telefonen, en gång) → från registrering till första sändning. Illustrationer i stället för
 * telefoner; tekniskt i känslan, utan att avslöja leverantörer eller arkitektur.
 */
import Phone from "../air/Phone.astro";
import ScreenHome from "../air/ScreenHome.astro";
import IconRow from "../IconRow.astro";
import Noise from "../how/Noise.astro";
import Intake from "../how/Intake.astro";
import Compare from "../how/Compare.astro";
import Topics from "../how/Topics.astro";
import { ROUTES, START_URL, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const REST = "0.5,0.5,0.1,0";
const id = sv
  ? { problem: "bruset", listen: "lyssnar", pick: "urvalet", inside: "publicerar", own: "eget", swipe: "svepet", start: "kom-igang", lang: "sprak", leaders: "ledningen" }
  : { problem: "noise", listen: "listen", pick: "selection", inside: "publish", own: "own", swipe: "swipe", start: "get-started", lang: "languages", leaders: "leaders" };

const c = sv
  ? {
      h1: "Nyheterna finns. Ingen hinner.",
      lead: "Branschen, marknaderna och det interna – på olika språk, från olika källor, publicerat när som helst. För mycket för en människa. Lagom för en värd.",
      m: ["Oberoende av språk", "Oberoende av klockslag", "Oberoende av hur många källor"],
      listenTitle: "Vi lyssnar på allt. Hela tiden.",
      listenLead: "Det som publiceras klockan tre på natten på tyska fångas lika säkert som morgonens svenska rubrik.",
      listenIcons: [["globe", "Alla språk"], ["clock", "Dygnet runt"], ["check", "Samma nyhet från flera källor blir en"]],
      pickTitle: "Vaskar fram det som är ert.",
      pickLead: "Ur bruset blir det en sändning: det interna först, sedan er bransch och era marknader, sist det du själv följer. Det du redan hört hoppas över.",
      bandHead: "Dagens sändning för Anna, förvaltare i Jönköping",
      groups: ["Internt – alla hör det", "Er omvärld – efter roll", "Ditt eget"],
      insideTitle: "Det interna som ingen läser.",
      insideLead: "Nyhetsbrevet ligger oläst. Säg det i stället en gång – med värdens röst, först i allas sändning – och se hur många som hört det.",
      insideIcons: [["mic", "Tala in eller skriv"], ["team", "Välj vilka som hör det"], ["eye", "Per team, aldrig per person"]],
      ownTitle: "Det du själv brinner för.",
      ownLead: "Räntor, energikrav eller HV71 – följ med ett tryck. Sändningen lär sig av vad du håller klotet på och vad du sveper förbi.",
      ownIcons: [["star", "Följ med ett tryck"], ["bell", "Något nytt varje dag"], ["check", "Blir bättre för varje sändning"]],
      swipeTitle: "Och allt det här blir … ett svep.",
      swipeLead: "Så mycket teknik. Så lite att göra. Dra upp klotet och lyssna, tre till tio minuter – på det språk du väljer av fyra.",
      swipeIcons: [["headphones", "Dra upp. Lyssna."], ["globe", "Fyra språk"], ["clock", "Tre till tio minuter"]],
      swipeLink: "Se det på startsidan",
      startTitle: "Från registrering till första sändning.",
      startLead: "Samma dag. Inga integrationer.",
      startSteps: [
        ["Registrera företaget", "Med er jobbmejl."],
        ["Vi läser in er värld", "Bransch, marknader, konkurrenter."],
        ["Bjud in kollegorna", "Ett mejl var. De är inne på en minut."],
        ["Första sändningen", "Samma dag."],
      ],
      sceneGreeting: "Hej Anna.",
      sceneDate: "Torsdag 23 oktober",
    }
  : {
      h1: "The news is out there. Nobody has the time.",
      lead: "The industry, the markets and the internal – in different languages, from different sources, published at any hour. Too much for a person. Just right for a host.",
      m: ["Regardless of language", "Regardless of the hour", "Regardless of how many sources"],
      listenTitle: "We listen to everything. All the time.",
      listenLead: "What is published at three in the morning in German is caught as surely as the Swedish headline of the morning.",
      listenIcons: [["globe", "Every language"], ["clock", "Around the clock"], ["check", "Several sources, one story"]],
      pickTitle: "We sift out what is yours.",
      pickLead: "Out of the noise comes a broadcast: internal first, then your industry and markets, last what you follow yourself. Anything you've already heard is skipped.",
      bandHead: "Today's broadcast for Anna, property manager in Jönköping",
      groups: ["Internal – everyone hears it", "Your world – by role", "Your own"],
      insideTitle: "The internal news nobody reads.",
      insideLead: "The newsletter sits unread. Say it once instead – in the host's voice, first in everyone's broadcast – and see how many heard it.",
      insideIcons: [["mic", "Record or type"], ["team", "Choose who hears it"], ["eye", "Per team, never per person"]],
      ownTitle: "What you care about.",
      ownLead: "Interest rates, energy rules or HV71 – follow with one tap. The broadcast learns from what you hold the orb on and what you swipe past.",
      ownIcons: [["star", "Follow with one tap"], ["bell", "Something new every day"], ["check", "Better with every broadcast"]],
      swipeTitle: "And all of this becomes … one swipe.",
      swipeLead: "So much technology. So little to do. Pull up the orb and listen, three to ten minutes – in the language you choose out of four.",
      swipeIcons: [["headphones", "Pull up. Listen."], ["globe", "Four languages"], ["clock", "Three to ten minutes"]],
      swipeLink: "See it on the start page",
      startTitle: "From sign-up to first broadcast.",
      startLead: "The same day. No integrations.",
      startSteps: [
        ["Register the company", "With your work email."],
        ["We read up on your world", "Industry, markets, competitors."],
        ["Invite your colleagues", "One email each. They are in within a minute."],
        ["The first broadcast", "The same day."],
      ],
      sceneGreeting: "Hi Anna.",
      sceneDate: "Thursday 23 October",
    };

const band = [
  [sv ? "Internt" : "Internal", sv ? "Hyresförhandlingen för 2027 är klar" : "The 2027 rent negotiation is done", 112, 72],
  [sv ? "Internt" : "Internal", sv ? "Hyresgästdag i Linden på torsdag" : "Tenant day at Linden", 96, 60],
  [sv ? "Räntor" : "Rates", sv ? "Sänkning före jul?" : "A cut before Christmas?", 150, 150],
  [sv ? "Lokalmarknaden" : "Office market", sv ? "Vakanserna minskar" : "Fewer empty offices", 128, 200],
  [sv ? "Energi" : "Energy", sv ? "Nya krav på energideklarationer" : "New energy rating rules", 150, 120],
  [sv ? "Stadsutveckling" : "City development", sv ? "1 200 bostäder vid Munksjön" : "1,200 homes by Munksjön", 166, 260],
  ["HV71", sv ? "Vände och vann i Linköping" : "Came back to win in Linköping", 140, 350],
  [sv ? "Något nytt" : "Something new", sv ? "Solceller på taken" : "Solar on the roofs", 144, 300],
] as [string, string, number, number][];
const groupW = [band[0]![2] + band[1]![2], band[2]![2] + band[3]![2] + band[4]![2] + band[5]![2], band[6]![2] + band[7]![2]];
const bubbles = sv
  ? [
      { label: "Internt", kind: "inside" as const, title: "Hyresförhandlingen för 2027 är klar" },
      { label: "Bransch", kind: "industry" as const, title: "Hyror upp 3,2 % i Småland" },
      { label: "Räntor", kind: "own" as const, title: "Marknaden räknar med sänkning före jul" },
      { label: "Bransch", kind: "industry" as const, title: "Vakanserna minskar i Småland" },
      { label: "Något nytt", kind: "surprise" as const, title: "Nya energikrav från årsskiftet" },
    ]
  : [
      { label: "Internal", kind: "inside" as const, title: "The 2027 rent negotiation is done" },
      { label: "Industry", kind: "industry" as const, title: "Rents up 3.2 % in Småland" },
      { label: "Rates", kind: "own" as const, title: "The market expects a cut before Christmas" },
      { label: "Industry", kind: "industry" as const, title: "Fewer empty offices in Småland" },
      { label: "Something new", kind: "surprise" as const, title: "New energy rules from the new year" },
    ];
---

<!-- 1. Problemet: bruset -->
<section class="section sub-top how-hero" id={id.problem} data-space data-hue="200" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack how-hero-text">
      <h1 class="title-hero">{c.h1}</h1>
      <p class="lead">{c.lead}</p>
    </div>
    <Noise lang={lang} />
    <ul class="how-meta" aria-hidden="true">
      {c.m.map((x) => <li>{x}</li>)}
    </ul>
  </div>
</section>

<!-- 2. Vi lyssnar på allt -->
<section class="section" id={id.listen} data-space data-hue="200" data-orb={REST} data-watch>
  <div class="split orb-left how-split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.listenTitle}</h2>
      <p class="lead">{c.listenLead}</p>
      <IconRow items={c.listenIcons as any} />
    </div>
    <div class="split-stage how-stage">
      <Intake lang={lang} />
    </div>
  </div>
</section>

<!-- 3. Urvalet: stapeln -->
<section class="section" id={id.pick} data-space data-hue="150" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.pickTitle}</h2>
      <p class="lead">{c.pickLead}</p>
    </div>
    <div class="band" aria-label={c.bandHead}>
      <div class="band-head"><span>{c.bandHead}</span><span>6 min 12 s</span></div>
      <div class="band-groups" aria-hidden="true">
        {groupW.map((w, i) => <div class="band-group" style={`flex: ${w} 1 0`}><span>{c.groups[i]}</span></div>)}
      </div>
      <div class="band-segs" aria-hidden="true">
        {band.map(([, , w, h], i) => <span class="band-seg" style={`flex: ${w} 1 0; --h: ${h}; --i: ${i}`} />)}
      </div>
      <div class="band-labels">
        {band.map(([t, d, w]) => (
          <div style={`flex: ${w} 1 0`}>
            <small>{t}</small>
            <span>{d}</span>
          </div>
        ))}
      </div>
      <div class="band-legend">
        {c.groups.map((g) => <span>{g}</span>)}
      </div>
    </div>
  </div>
</section>

<!-- 4. Det interna som ingen läser -->
<section class="section" id={id.inside} data-space data-hue="72" data-orb={REST} data-watch>
  <div class="split how-split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.insideTitle}</h2>
      <p class="lead">{c.insideLead}</p>
      <IconRow items={c.insideIcons as any} />
    </div>
    <div class="split-stage how-stage">
      <Compare lang={lang} />
    </div>
  </div>
</section>

<!-- 5. Det du själv brinner för -->
<section class="section" id={id.own} data-space data-hue="300" data-orb={REST} data-watch>
  <div class="split orb-left how-split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.ownTitle}</h2>
      <p class="lead">{c.ownLead}</p>
      <IconRow items={c.ownIcons as any} />
    </div>
    <div class="split-stage how-stage">
      <Topics lang={lang} />
    </div>
  </div>
</section>

<!-- 6. Ett svep: telefonen, en gång -->
<section class="section section-center" id={id.swipe} data-space data-hue="262" data-orb={REST} data-watch>
  <div class="center-wrap">
    <div class="stack center-head">
      <h2 class="title-xl">{c.swipeTitle}</h2>
      <p class="lead">{c.swipeLead}</p>
      <IconRow items={c.swipeIcons as any} class="icon-row-center" />
    </div>
    <div class="center-stage stage-device">
      <Phone label={sv ? "Newstail-appen: dra upp klotet och lyssna" : "The Newstail app: pull up the orb and listen"}>
        <ScreenHome company="NORDVIK" greeting={c.sceneGreeting} date={c.sceneDate} items={bubbles} lit={4} />
      </Phone>
    </div>
    <a class="link-more" href={`${R.home}#scen`}>{c.swipeLink}</a>
  </div>
</section>

<!-- 7. Kom igång -->
<section class="section" id={id.start} data-space data-hue="200" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.startTitle}</h2>
      <p class="lead">{c.startLead}</p>
    </div>
    <div class="grid-4">
      {c.startSteps.map(([t, d], i) => (
        <div class="lined">
          <span class="n">{i + 1}</span>
          <strong>{t}</strong>
          <span>{d}</span>
        </div>
      ))}
    </div>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{ui.startLong}</a>
    </div>
    <p class="note">{ui.noCard}</p>
  </div>
</section>
