---
/**
 * Så funkar det (2026-10-26, i startsidans grammatik): en idé per skärm – rubrik, ingress och
 * en hel telefon. Inga etiketter, inget band, inga kort. Tre roller i följd: den som lyssnar
 * (sändningen, språket, efteråt, ikapp), den som publicerar (publicera, fredagsmejlet) och
 * ledningen (admin-kortet). Sist: från registrering till första sändning.
 */
import Phone from "../air/Phone.astro";
import ScreenPlayer from "../air/ScreenPlayer.astro";
import ScreenLang from "../air/ScreenLang.astro";
import ScreenRecap from "../air/ScreenRecap.astro";
import ScreenIkapp from "../air/ScreenIkapp.astro";
import ScreenPublish from "../air/ScreenPublish.astro";
import MailCard from "../air/MailCard.astro";
import AdminCard from "../air/AdminCard.astro";
import IconRow from "../IconRow.astro";
import { ROUTES, START_URL, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const REST = "0.5,0.5,0.1,0";
const id = sv
  ? { listen: "lyssnar", lang: "sprak", after: "efterat", ikapp: "ikapp", publish: "publicerar", friday: "fredag", leaders: "ledningen", start: "kom-igang" }
  : { listen: "listen", lang: "languages", after: "after", ikapp: "caught-up", publish: "publish", friday: "friday", leaders: "leaders", start: "get-started" };

const c = sv
  ? {
      h1: "Så funkar det.",
      lead: "Dra upp. Värden börjar berätta.",
      heroIcons: [["clock", "Tre till tio minuter"], ["headphones", "Internt först"], ["check", "Det hörda hoppas över"]],
      langTitle: "Samma budskap. Ditt språk.",
      langLead: "Anna spelade in det på svenska. Alla hörde det på sitt språk.",
      langHeading: "Samma nyhet.",
      langs: [
        { code: "SV", name: "Svenska", title: "Vi förvärvar två fastigheter i centrala Växjö" },
        { code: "EN", name: "English", title: "We are acquiring two properties in central Växjö" },
        { code: "DE", name: "Deutsch", title: "Wir erwerben zwei Immobilien im Zentrum von Växjö" },
        { code: "ES", name: "Español", title: "Adquirimos dos inmuebles en el centro de Växjö" },
      ],
      afterTitle: "Efteråt: läs mer, dela, minns.",
      afterIcons: [["doc", "Punkterna med källor"], ["share", "Skicka till en kollega"], ["check", "Ett kort quiz"]],
      ikappTitle: "Du är ikapp.",
      ikappLead: "Det du behöver veta. Inget annat. Klotet blir dagens stjärna – sju blir veckans stjärnbild.",
      ikappBtn: "Se ögonblicket",
      pubTitle: "Säg det en gång. Vi läser upp det.",
      pubLead: "Bara de ni utser kan publicera.",
      pubIcons: [["mic", "Tala in"], ["pen", "Eller skriv"], ["team", "Välj vilka som hör det"]],
      teams: ["Alla", "Förvaltning Jönköping", "Förvaltning Växjö", "Projekt"],
      friTitle: "Missade man det, kommer det på fredag.",
      friLead: "Den som inte hört ett internt budskap får det i fredagsmejlet. Ledningen får veckans ”34 av 41”.",
      leadTitle: "Se att det når fram.",
      leadIcons: [["team", "Per team"], ["lock", "Aldrig per person"], ["bars", "Räckvidd och minne"]],
      leadLink: "Vad ledningen inte ser",
      startTitle: "Från registrering till första sändning.",
      startLead: "Samma dag. Inga integrationer.",
      startSteps: [
        ["Registrera företaget", "Med er jobbmejl."],
        ["Vi läser in er värld", "Bransch, marknader, konkurrenter."],
        ["Bjud in kollegorna", "Ett mejl var. De är inne på en minut."],
        ["Första sändningen", "Samma dag."],
      ],
    }
  : {
      h1: "How it works.",
      lead: "Pull up. The host starts talking.",
      heroIcons: [["clock", "Three to ten minutes"], ["headphones", "Internal first"], ["check", "Heard stories skipped"]],
      langTitle: "Same message. Your language.",
      langLead: "Anna recorded it in Swedish. Everyone heard it in their own language.",
      langHeading: "Same story.",
      langs: [
        { code: "EN", name: "English", title: "We are acquiring two properties in central Växjö" },
        { code: "SV", name: "Svenska", title: "Vi förvärvar två fastigheter i centrala Växjö" },
        { code: "DE", name: "Deutsch", title: "Wir erwerben zwei Immobilien im Zentrum von Växjö" },
        { code: "ES", name: "Español", title: "Adquirimos dos inmuebles en el centro de Växjö" },
      ],
      afterTitle: "Afterwards: read more, share, remember.",
      afterIcons: [["doc", "The stories with sources"], ["share", "Send to a colleague"], ["check", "A short quiz"]],
      ikappTitle: "You're caught up.",
      ikappLead: "What you need to know. Nothing else. The orb becomes today's star – seven make the week's constellation.",
      ikappBtn: "See the moment",
      pubTitle: "Say it once. We read it out.",
      pubLead: "Only the people you choose can publish.",
      pubIcons: [["mic", "Record"], ["pen", "Or type"], ["team", "Choose who hears it"]],
      teams: ["Everyone", "Property mgmt Jönköping", "Property mgmt Växjö", "Projects"],
      friTitle: "Missed it? It comes on Friday.",
      friLead: "Anyone who hasn't heard an internal message gets it in the Friday email. Management gets the week's “34 of 41”.",
      leadTitle: "See that it gets through.",
      leadIcons: [["team", "Per team"], ["lock", "Never per person"], ["bars", "Reach and recall"]],
      leadLink: "What management never sees",
      startTitle: "From sign-up to first broadcast.",
      startLead: "The same day. No integrations.",
      startSteps: [
        ["Register the company", "With your work email."],
        ["We read up on your world", "Industry, markets, competitors."],
        ["Invite your colleagues", "One email each. They are in within a minute."],
        ["The first broadcast", "The same day."],
      ],
    };

const player = sv
  ? [
      { topic: "INTERNT", title: "Vi förvärvar två fastigheter i centrala Växjö", src: "Anna Lindqvist", hue: 72, inside: true },
      { topic: "RÄNTOR", title: "Marknaden räknar med sänkning före jul", src: "Dagens industri · SvD", hue: 150 },
      { topic: "NÅGOT NYTT", title: "Solceller på taken: nya stödregler för flerbostadshus", src: "2 källor", hue: 300 },
    ]
  : [
      { topic: "INTERNAL", title: "We are acquiring two properties in central Växjö", src: "Anna Lindqvist", hue: 72, inside: true },
      { topic: "RATES", title: "The market expects a cut before Christmas", src: "Dagens industri · SvD", hue: 150 },
      { topic: "SOMETHING NEW", title: "Solar on the roofs: new support for apartment blocks", src: "2 sources", hue: 300 },
    ];
const recap = sv
  ? {
      date: "Idag",
      sub: "7 punkter · 6 min",
      send: "Skicka till kollega",
      share: "Dela",
      items: [
        { topic: "RÄNTOR", title: "Ränteläget: marknaden räknar med sänkning före jul", text: "Bankerna räknar med en sänkning men inte hur stor. Det påverkar värderingarna inför bokslutet.", src: "3 källor" },
        { topic: "LOKALMARKNADEN", title: "Vakanserna minskar i Smålands kontorsmarknad", src: "2 källor" },
      ],
      sheet: { title: "Skicka till", people: ["Johan", "Sara", "Elif", "Mateusz"], note: "Värt att ha med sig inför budgetmötet.", button: "Skicka", foot: "Johan hör det i sin nästa sändning." },
    }
  : {
      date: "Today",
      sub: "7 stories · 6 min",
      send: "Send to colleague",
      share: "Share",
      items: [
        { topic: "RATES", title: "Rates: the market expects a cut before Christmas", text: "Banks expect a cut but not how big. It affects valuations ahead of year-end.", src: "3 sources" },
        { topic: "OFFICE MARKET", title: "Fewer empty offices in Småland", src: "2 sources" },
      ],
      sheet: { title: "Send to", people: ["Johan", "Sara", "Elif", "Mateusz"], note: "Worth having before the budget meeting.", button: "Send", foot: "Johan hears it in his next broadcast." },
    };
const ikapp = sv
  ? { before: "Sista nyheten slutar …", done: "Du är ikapp.", streak: "Dra för att höra den igen.", recap: "Recap", quiz: "Quiz" }
  : { before: "The last story ends …", done: "You're caught up.", streak: "Pull up to hear it again.", recap: "Recap", quiz: "Quiz" };
const publish = sv
  ? { head: "NORDVIK", eyebrow: "NY INTERN NYHET", title: "Vad vill du berätta?", hint: "Tryck på klotet för att börja spela in.", write: "Skriv istället", published: "Publicerat" }
  : { head: "NORDVIK", eyebrow: "NEW INTERNAL NEWS", title: "What do you want to say?", hint: "Tap the orb to start recording.", write: "Type instead", published: "Published" };
const mail = sv
  ? { from: "Newstail", when: "fre 15:00", subject: "Det här missade du", company: "NORDVIK", title: "Det här missade du", sub: "Två interna budskap från veckan.", items: ["Hyresförhandlingen för 2027 är klar", "Hyresgästdag i Kvarteret Linden på torsdag"], tag: "INTERNT", button: "Lyssna i appen" }
  : { from: "Newstail", when: "Fri 15:00", subject: "What you missed", company: "NORDVIK", title: "What you missed", sub: "Two internal messages from this week.", items: ["The 2027 rent negotiation is done", "Tenant day at Kvarteret Linden on Thursday"], tag: "INTERNAL", button: "Listen in the app" };
---

<!-- 1. Sändningen – också sidans hero -->
<section class="section sub-top" id={id.listen} data-space data-hue="150" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h1 class="title-hero">{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <IconRow items={c.heroIcons as any} />
    </div>
    <div class="split-stage stage-device">
      <Phone label={sv ? "Sändningen i Newstail-appen" : "The broadcast in the Newstail app"}>
        <ScreenPlayer items={player} done={sv ? "Avsluta" : "End"} />
      </Phone>
    </div>
  </div>
</section>

<!-- 2. Språket -->
<section class="section" id={id.lang} data-space data-hue="262" data-orb={REST} data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <h2 class="title-xl">{c.langTitle}</h2>
      <p class="lead">{c.langLead}</p>
    </div>
    <div class="split-stage stage-device" data-lang-cycle>
      <Phone label={sv ? "Samma interna nyhet på fyra språk" : "The same internal story in four languages"}>
        <ScreenLang company="NORDVIK" heading={c.langHeading} items={c.langs} />
      </Phone>
    </div>
  </div>
</section>

<!-- 3. Efteråt -->
<section class="section" id={id.after} data-space data-hue="300" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.afterTitle}</h2>
      <IconRow items={c.afterIcons as any} />
    </div>
    <div class="split-stage stage-device">
      <Phone label={sv ? "Recapen med Skicka till kollega" : "The recap with Send to colleague"}>
        <ScreenRecap lang={lang} {...recap} />
      </Phone>
    </div>
  </div>
</section>

<!-- 4. Ikapp -->
<section class="section" id={id.ikapp} data-space data-hue="300" data-orb={REST} data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <h2 class="title-xl">{c.ikappTitle}</h2>
      <p class="lead">{c.ikappLead}</p>
      <div class="actions">
        <button class="pill pill-secondary pill-lg" type="button" data-ikapp-replay>
          <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z"></path></svg>
          {c.ikappBtn}
        </button>
      </div>
    </div>
    <div class="split-stage stage-device">
      <Phone label={sv ? "Du är ikapp – klotet blir dagens stjärna" : "You're caught up – the orb becomes today's star"}>
        <ScreenIkapp t={ikapp} />
      </Phone>
    </div>
  </div>
</section>

<!-- 5. Publicera -->
<section class="section" id={id.publish} data-space data-hue="72" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.pubTitle}</h2>
      <p class="lead">{c.pubLead}</p>
      <IconRow items={c.pubIcons as any} />
      <div class="chips" aria-hidden="true">
        {c.teams.map((t, i) => <span class={`chip${i === 0 ? " chip-on" : ""}`}>{t}</span>)}
      </div>
    </div>
    <div class="split-stage stage-device stage-glow" style="--glow-hue: 80">
      <Phone label={sv ? "Publicera i Newstail-appen" : "Publishing in the Newstail app"}>
        <ScreenPublish t={publish} />
      </Phone>
    </div>
  </div>
</section>

<!-- 6. Fredagsmejlet -->
<section class="section" id={id.friday} data-space data-hue="72" data-orb={REST} data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <h2 class="title-xl">{c.friTitle}</h2>
      <p class="lead">{c.friLead}</p>
    </div>
    <div class="split-stage stage-mail">
      <MailCard t={mail} />
    </div>
  </div>
</section>

<!-- 7. Ledningen -->
<section class="section section-lead" id={id.leaders} data-space data-hue="262" data-orb={REST} data-watch>
  <div class="lead-wrap">
    <div class="stack lead-head">
      <h2 class="title-xl">{c.leadTitle}</h2>
      <IconRow items={c.leadIcons as any} class="icon-row-center" />
      <a class="link-more" href={`${R.trust}${sv ? "#ser" : "#sees"}`}>{c.leadLink}</a>
    </div>
    <div class="lead-stage">
      <AdminCard lang={lang} />
      <p class="note">{ui.demoNote}</p>
    </div>
  </div>
</section>

<!-- 8. Kom igång -->
<section class="section" id={id.start} data-space data-hue="200" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.startTitle}</h2>
      <p class="lead">{c.startLead}</p>
    </div>
    <div class="grid-4">
      {c.startSteps.map(([t, d], i) => (
        <div class="lined">
          <span class="n">{i + 1}</span>
          <strong>{t}</strong>
          <span>{d}</span>
        </div>
      ))}
    </div>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{ui.startLong}</a>
    </div>
    <p class="note">{ui.noCard}</p>
  </div>
</section>

<script>
  // Språket: bubblorna tänds en i taget medan telefonen syns.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-lang-cycle]").forEach((stage) => {
    const bubbles = [...stage.querySelectorAll<HTMLElement>("[data-lang-b]")];
    if (bubbles.length < 2) return;
    let i = 0;
    let timer = 0;
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => {
        i = (i + 1) % bubbles.length;
        bubbles.forEach((b, j) => b.classList.toggle("is-on", j === i));
      }, 3000);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(stage);
  });
</script>
