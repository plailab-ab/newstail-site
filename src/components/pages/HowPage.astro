---
/** Så funkar det (ersätter Tekniken): tre roller – den som lyssnar, den som publicerar, ledningen. */
import Phone from "../air/Phone.astro";
import ScreenPlayer from "../air/ScreenPlayer.astro";
import ScreenRecap from "../air/ScreenRecap.astro";
import ScreenIkapp from "../air/ScreenIkapp.astro";
import MailCard from "../air/MailCard.astro";
import { ROUTES, START_URL, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const id = sv
  ? { listen: "lyssnar", lang: "sprak", after: "efterat", ikapp: "ikapp", publish: "publicerar", friday: "fredag", leaders: "ledningen", start: "kom-igang" }
  : { listen: "listen", lang: "languages", after: "after", ikapp: "caught-up", publish: "publish", friday: "friday", leaders: "leaders", start: "get-started" };

const c = sv
  ? {
      h1: "Så funkar det.",
      lead: "En egen sändning för varje medarbetare. Tre roller får det att fungera.",
      roles: ["Den som lyssnar", "Den som publicerar", "Ledningen"],
      bandHead: "En sändning för Anna, förvaltare i Jönköping",
      groups: ["Internt – alla hör det", "Er omvärld – efter roll", "Ditt eget"],
      listenTitle: "Dra upp. Värden börjar berätta.",
      listenLead: "Internt först. Sist det du själv följer.",
      listenPoints: [
        ["Tre till tio minuter", "Det du redan hört hoppas över."],
        ["Tryck, svep, håll", "Paus, nästa – håll klotet så berättar värden mer."],
        ["Något nytt varje dag", "Utanför dina ämnen. Följ med ett tryck."],
      ],
      ios: ["Notis med dagens rubrik", "Dynamic Island", "Låsskärmen", "Hörlurar", "Siri och Action-knappen", "Veckomejl på fredag", "CarPlay – på väg"],
      langTitle: "Samma budskap. Ditt språk.",
      langLead: "Anna spelade in det på svenska. Alla hörde det på sitt språk.",
      langs: [
        ["Svenska", "Vi förvärvar två fastigheter i centrala Växjö", "Så spelade Anna in det"],
        ["English", "We are acquiring two properties in central Växjö", "Så hörde Mateusz det"],
        ["Deutsch", "Wir erwerben zwei Immobilien im Zentrum von Växjö", "Så hörde Jonas det"],
        ["Español", "Adquirimos dos inmuebles en el centro de Växjö", "Så hörde Lucía det"],
      ],
      afterTitle: "Efteråt: läs mer, dela, minns.",
      afterPoints: [
        ["Recapen", "Punkterna i text, med källor."],
        ["Skicka till en kollega", "”Anna skickade dig det här …”"],
        ["Ett kort quiz", "Så att det fastnar."],
      ],
      ikappTitle: "Du är ikapp.",
      ikappLead: "Det du behöver veta. Inget annat. Klotet blir dagens stjärna – sju blir veckans stjärnbild.",
      ikappBtn: "Se ögonblicket",
      pubTitle: "Säg det en gång. Vi läser upp det.",
      pubLead: "Tala in eller skriv. Värden lägger det först i allas nästa sändning.",
      steps: ["Tala in eller skriv", "Värden formulerar", "Lyssna innan", "Välj vilka som hör det"],
      quote: "”Vi har tecknat avtal om att köpa två kontorsfastigheter på Sandgärdsgatan i Växjö, med tillträde i februari …”",
      preview: "0:24 · så som alla kommer att höra det",
      teams: ["Alla", "Förvaltning Jönköping", "Förvaltning Växjö", "Projekt"],
      pubNote: "Bara de ni utser kan publicera.",
      friTitle: "Missade man det, kommer det på fredag.",
      friLead: "Den som inte hört ett internt budskap får det i fredagsmejlet. Ledningen får veckans ”34 av 41”.",
      leadTitle: "Se att det når fram.",
      leadLead: "Räckvidd och minne per team. Aldrig per person.",
      leadLink: "Vad ledningen inte ser",
      latest: "Senaste interna",
      reach: [
        ["Vi förvärvar två fastigheter i centrala Växjö", 38, 41, "Alla · Anna Lindqvist"],
        ["Hyresförhandlingen för 2027 är klar", 34, 41, "Alla · Anna Lindqvist"],
        ["Hyresgästdag i Kvarteret Linden på torsdag", 12, 14, "Förvaltning Jönköping"],
      ],
      stats: [["34 av 41", "har lyssnat i veckan"], ["80 %", "mindes rätt i quizen"]],
      startTitle: "Från registrering till första sändning.",
      startLead: "Inga integrationer.",
      startSteps: [
        ["Registrera företaget", "Med er jobbmejl."],
        ["Vi läser in er värld", "Bransch, marknader, konkurrenter."],
        ["Kollegorna går med", "Med sin jobbmejl. Ingen inbjudan behövs."],
        ["Första sändningen", "Samma dag."],
      ],
      listenAgain: "Hör ett exempel",
    }
  : {
      h1: "How it works.",
      lead: "A broadcast of their own for every employee. Three roles make it work.",
      roles: ["The listener", "The publisher", "Management"],
      bandHead: "A broadcast for Anna, property manager in Jönköping",
      groups: ["Internal – everyone hears it", "Your world – by role", "Your own"],
      listenTitle: "Pull up. The host starts talking.",
      listenLead: "Internal first. Last, what you follow yourself.",
      listenPoints: [
        ["Three to ten minutes", "Anything you've already heard is skipped."],
        ["Tap, swipe, hold", "Pause, next – hold the orb and the host tells you more."],
        ["Something new every day", "Outside your topics. Follow it with one tap."],
      ],
      ios: ["Notification with today's headline", "Dynamic Island", "Lock screen", "Headphones", "Siri and the Action button", "Weekly email on Fridays", "CarPlay – on the way"],
      langTitle: "Same message. Your language.",
      langLead: "Anna recorded it in Swedish. Everyone heard it in their own language.",
      langs: [
        ["Svenska", "Vi förvärvar två fastigheter i centrala Växjö", "How Anna recorded it"],
        ["English", "We are acquiring two properties in central Växjö", "How Mateusz heard it"],
        ["Deutsch", "Wir erwerben zwei Immobilien im Zentrum von Växjö", "How Jonas heard it"],
        ["Español", "Adquirimos dos inmuebles en el centro de Växjö", "How Lucía heard it"],
      ],
      afterTitle: "Afterwards: read more, share, remember.",
      afterPoints: [
        ["The recap", "The stories as text, with sources."],
        ["Send to a colleague", "“Anna sent you this …”"],
        ["A short quiz", "So that it sticks."],
      ],
      ikappTitle: "You're caught up.",
      ikappLead: "What you need to know. Nothing else. The orb becomes today's star – seven make the week's constellation.",
      ikappBtn: "See the moment",
      pubTitle: "Say it once. We read it out.",
      pubLead: "Record or type it. The host puts it first in everyone's next broadcast.",
      steps: ["Record or type", "The host words it", "Listen first", "Choose who hears it"],
      quote: "“We have signed an agreement to buy two office properties on Sandgärdsgatan in Växjö, with access in February …”",
      preview: "0:24 · exactly as everyone will hear it",
      teams: ["Everyone", "Property mgmt Jönköping", "Property mgmt Växjö", "Projects"],
      pubNote: "Only the people you choose can publish.",
      friTitle: "Missed it? It comes on Friday.",
      friLead: "Anyone who hasn't heard an internal message gets it in the Friday email. Management gets the week's “34 of 41”.",
      leadTitle: "See that it gets through.",
      leadLead: "Reach and recall per team. Never per person.",
      leadLink: "What management never sees",
      latest: "Latest internal",
      reach: [
        ["We are acquiring two properties in central Växjö", 38, 41, "Everyone · Anna Lindqvist"],
        ["The 2027 rent negotiation is done", 34, 41, "Everyone · Anna Lindqvist"],
        ["Tenant day at Kvarteret Linden on Thursday", 12, 14, "Property mgmt Jönköping"],
      ],
      stats: [["34 of 41", "listened this week"], ["80 %", "remembered correctly"]],
      startTitle: "From sign-up to first broadcast.",
      startLead: "No integrations.",
      startSteps: [
        ["Register the company", "With your work email."],
        ["We read up on your world", "Industry, markets, competitors."],
        ["Colleagues join", "With their work email. No invitations needed."],
        ["The first broadcast", "The same day."],
      ],
      listenAgain: "Hear an example",
    };

const band = [
  [sv ? "Internt" : "Internal", sv ? "Hyresförhandlingen för 2027 är klar" : "The 2027 rent negotiation is done", 112, 72],
  [sv ? "Internt" : "Internal", sv ? "Hyresgästdag i Linden på torsdag" : "Tenant day at Linden", 96, 60],
  [sv ? "Räntor" : "Rates", sv ? "Sänkning före jul?" : "A cut before Christmas?", 150, 150],
  [sv ? "Lokalmarknaden" : "Office market", sv ? "Vakanserna minskar" : "Fewer empty offices", 128, 200],
  [sv ? "Energi" : "Energy", sv ? "Nya krav på energideklarationer" : "New energy rating rules", 150, 120],
  [sv ? "Stadsutveckling" : "City development", sv ? "1 200 bostäder vid Munksjön" : "1,200 homes by Munksjön", 166, 260],
  ["HV71", sv ? "Vände och vann i Linköping" : "Came back to win in Linköping", 140, 350],
  [sv ? "Något nytt" : "Something new", sv ? "Solceller på taken" : "Solar on the roofs", 144, 300],
] as [string, string, number, number][];
const groupW = [band[0]![2] + band[1]![2], band[2]![2] + band[3]![2] + band[4]![2] + band[5]![2], band[6]![2] + band[7]![2]];

const player = sv
  ? [
      { topic: "RÄNTOR", title: "Ränteläget: marknaden räknar med sänkning före jul", src: "3 källor", hue: 150 },
      { topic: "ENERGI", title: "Nya krav på energideklarationer från årsskiftet", src: "2 källor", hue: 200 },
      { topic: "NÅGOT NYTT", title: "Solceller på taken: nya stödregler för flerbostadshus", src: "2 källor", hue: 300 },
    ]
  : [
      { topic: "RATES", title: "Rates: the market expects a cut before Christmas", src: "3 sources", hue: 150 },
      { topic: "ENERGY", title: "New energy rating rules from the new year", src: "2 sources", hue: 200 },
      { topic: "SOMETHING NEW", title: "Solar on the roofs: new support for apartment blocks", src: "2 sources", hue: 300 },
    ];
const recap = sv
  ? {
      date: "Idag",
      sub: "7 punkter · 6 min",
      send: "Skicka till kollega",
      share: "Dela",
      items: [
        { topic: "RÄNTOR", title: "Ränteläget: marknaden räknar med sänkning före jul", text: "Bankerna räknar med en sänkning men inte hur stor. Det påverkar värderingarna inför bokslutet.", src: "3 källor" },
        { topic: "LOKALMARKNADEN", title: "Vakanserna minskar i Smålands kontorsmarknad", src: "2 källor" },
      ],
      sheet: { title: "Skicka till", people: ["Johan", "Sara", "Elif", "Mateusz"], note: "Värt att ha med sig inför budgetmötet.", button: "Skicka", foot: "Johan hör det i sin nästa sändning." },
    }
  : {
      date: "Today",
      sub: "7 stories · 6 min",
      send: "Send to colleague",
      share: "Share",
      items: [
        { topic: "RATES", title: "Rates: the market expects a cut before Christmas", text: "Banks expect a cut but not how big. It affects valuations ahead of year-end.", src: "3 sources" },
        { topic: "OFFICE MARKET", title: "Fewer empty offices in Småland", src: "2 sources" },
      ],
      sheet: { title: "Send to", people: ["Johan", "Sara", "Elif", "Mateusz"], note: "Worth having before the budget meeting.", button: "Send", foot: "Johan hears it in his next broadcast." },
    };
const ikapp = sv
  ? { before: "Sista nyheten slutar …", done: "Du är ikapp.", streak: "Dra för att höra den igen.", recap: "Recap", quiz: "Quiz" }
  : { before: "The last story ends …", done: "You're caught up.", streak: "Pull up to hear it again.", recap: "Recap", quiz: "Quiz" };
const mail = sv
  ? { from: "Newstail", when: "fre 15:00", subject: "Det här missade du", company: "NORDVIK", title: "Det här missade du", sub: "Två interna budskap från veckan.", items: ["Hyresförhandlingen för 2027 är klar", "Hyresgästdag i Kvarteret Linden på torsdag"], tag: "INTERNT", button: "Lyssna i appen" }
  : { from: "Newstail", when: "Fri 15:00", subject: "What you missed", company: "NORDVIK", title: "What you missed", sub: "Two internal messages from this week.", items: ["The 2027 rent negotiation is done", "Tenant day at Kvarteret Linden on Thursday"], tag: "INTERNAL", button: "Listen in the app" };
---

<section class="section sub-top" data-space data-hue="200" data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h1 class="title-hero">{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="chips">
        <a class="chip" href={`#${id.listen}`}>{c.roles[0]}</a>
        <a class="chip" href={`#${id.publish}`}>{c.roles[1]}</a>
        <a class="chip" href={`#${id.leaders}`}>{c.roles[2]}</a>
      </div>
    </div>
    <div class="band" aria-label={c.bandHead}>
      <div class="band-head"><span>{c.bandHead}</span><span>6 min 12 s</span></div>
      <div class="band-groups" aria-hidden="true">
        {groupW.map((w, i) => <div class="band-group" style={`flex: ${w} 1 0`}><span>{c.groups[i]}</span></div>)}
      </div>
      <div class="band-segs" aria-hidden="true">
        {band.map(([, , w, h], i) => <span class="band-seg" style={`flex: ${w} 1 0; --h: ${h}; --i: ${i}`} />)}
      </div>
      <div class="band-labels">
        {band.map(([t, d, w]) => (
          <div style={`flex: ${w} 1 0`}>
            <small>{t}</small>
            <span>{d}</span>
          </div>
        ))}
      </div>
      <div class="band-legend">
        {c.groups.map((g) => <span>{g}</span>)}
      </div>
    </div>
  </div>
</section>

<section class="section" id={id.listen} data-space data-hue="150" data-watch>
  <div class="split">
    <div class="split-text stack">
      <p class="kicker">{c.roles[0]}</p>
      <h2 class="title-xl">{c.listenTitle}</h2>
      <p class="lead">{c.listenLead}</p>
      <ul class="points">{c.listenPoints.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}</ul>
      <div class="chips">{c.ios.map((x) => <span class="chip">{x}</span>)}</div>
    </div>
    <div class="split-stage stage-device stage-glow" style="--glow-hue: 160">
      <Phone label={sv ? "Sändningen i Newstail-appen" : "The broadcast in the Newstail app"}>
        <ScreenPlayer items={player} done={sv ? "Avsluta" : "End"} />
      </Phone>
    </div>
  </div>
</section>

<section class="section" id={id.lang} data-space data-hue="262" data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <p class="kicker">{c.roles[0]}</p>
      <h2 class="title-xl">{c.langTitle}</h2>
      <p class="lead">{c.langLead}</p>
    </div>
    <div class="grid-4">
      {c.langs.map(([name, t, who]) => (
        <div class="tile lang-card">
          <span class="lang-top"><span>{name}</span><span class="lang-play" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="#eceff4"><path d="M3 1.5v9l7.5-4.5z"></path></svg></span></span>
          <h3>{t}</h3>
          <small>{who}</small>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section" id={id.after} data-space data-hue="300" data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <p class="kicker">{c.roles[0]}</p>
      <h2 class="title-xl">{c.afterTitle}</h2>
      <ul class="points">{c.afterPoints.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}</ul>
    </div>
    <div class="split-stage stage-device">
      <Phone label={sv ? "Recapen med Skicka till kollega" : "The recap with Send to colleague"}>
        <ScreenRecap lang={lang} {...recap} />
      </Phone>
    </div>
  </div>
</section>

<section class="section" id={id.ikapp} data-space data-hue="300" data-watch>
  <div class="split">
    <div class="split-text stack">
      <p class="kicker">{c.roles[0]}</p>
      <h2 class="title-xl">{c.ikappTitle}</h2>
      <p class="lead">{c.ikappLead}</p>
      <div class="actions">
        <button class="pill pill-secondary pill-lg" type="button" data-ikapp-replay>
          <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z"></path></svg>
          {c.ikappBtn}
        </button>
      </div>
    </div>
    <div class="split-stage stage-device">
      <Phone label={sv ? "Du är ikapp – klotet blir dagens stjärna" : "You're caught up – the orb becomes today's star"}>
        <ScreenIkapp t={ikapp} />
      </Phone>
    </div>
  </div>
</section>

<section class="section" id={id.publish} data-space data-hue="72" data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <p class="kicker">{c.roles[1]}</p>
      <h2 class="title-xl">{c.pubTitle}</h2>
      <p class="lead">{c.pubLead}</p>
    </div>
    <div class="flow-row">
      <div class="tile">
        <span class="n">1</span>
        <span class="vis"><img src="/orbs/orb-72.webp" alt="" width="92" height="92" loading="lazy" /></span>
        <h3>{c.steps[0]}</h3>
      </div>
      <svg class="flow-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
      <div class="tile">
        <span class="n">2</span>
        <span class="vis text">{c.quote}</span>
        <h3>{c.steps[1]}</h3>
      </div>
      <svg class="flow-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
      <div class="tile">
        <span class="n">3</span>
        <span class="vis" style="flex-direction: column; align-items: stretch; gap: 0.8rem">
          <span style="display: flex; align-items: center; gap: 0.7rem"><span class="pb-mini"></span><span class="bar" style="flex: 1 1 auto"><span style="width: 40%"></span></span></span>
          <small class="subtle" style="font-size: 0.8125rem">{c.preview}</small>
        </span>
        <h3>{c.steps[2]}</h3>
      </div>
      <svg class="flow-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
      <div class="tile">
        <span class="n">4</span>
        <span class="vis"><span class="chips">{c.teams.map((t, i) => <span class={`chip${i === 0 ? " chip-on" : ""}`}>{t}</span>)}</span></span>
        <h3>{c.steps[3]}</h3>
      </div>
    </div>
    <p class="note">{c.pubNote}</p>
  </div>
</section>

<section class="section" id={id.friday} data-space data-hue="72" data-watch>
  <div class="split">
    <div class="split-text stack">
      <p class="kicker">{c.roles[1]}</p>
      <h2 class="title-xl">{c.friTitle}</h2>
      <p class="lead">{c.friLead}</p>
    </div>
    <div class="split-stage stage-mail">
      <MailCard t={mail} />
    </div>
  </div>
</section>

<section class="section" id={id.leaders} data-space data-hue="262" data-watch>
  <div class="split">
    <div class="split-text stack">
      <p class="kicker">{c.roles[2]}</p>
      <h2 class="title-xl">{c.leadTitle}</h2>
      <p class="lead">{c.leadLead}</p>
      <a class="link-more" href={`${R.trust}${sv ? "#ser" : "#sees"}`}>{c.leadLink}</a>
    </div>
    <div class="split-stage stage-reach">
      <div class="tile">
        <small class="subtle">{c.latest}</small>
        <div class="reach-list">
          {c.reach.map(([t, a, b, who]) => (
            <div class="reach-row">
              <span><b>{t}</b><i>{a} {sv ? "av" : "of"} {b}</i></span>
              <span class="bar"><span style={`width: ${Math.round(((a as number) / (b as number)) * 100)}%`}></span></span>
              <small>{who}</small>
            </div>
          ))}
        </div>
      </div>
      <div class="stat-pair">
        {c.stats.map(([v, l]) => <div class="tile"><b>{v}</b><small class="subtle">{l}</small></div>)}
      </div>
      <p class="note">{ui.demoNote}</p>
    </div>
  </div>
</section>

<section class="section" id={id.start} data-space data-hue="200" data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.startTitle}</h2>
      <p class="lead">{c.startLead}</p>
    </div>
    <div class="grid-4">
      {c.startSteps.map(([t, d], i) => (
        <div class="lined">
          <span class="n">{i + 1}</span>
          <strong>{t}</strong>
          <span>{d}</span>
        </div>
      ))}
    </div>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{ui.startLong}</a>
      <a class="pill pill-secondary pill-lg" href={`${R.home}`}>{c.listenAgain}</a>
    </div>
    <p class="note">{ui.noCard}</p>
  </div>
</section>
