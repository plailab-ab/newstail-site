---
/**
 * Trygghet (2026-10-27, blankt blad): tryggheten är byggd in i produkten, inte en inställning.
 * 1 aggregatet (41 personer blir ett tal, små team låsta) · 2 vad ledningen ser och aldrig ser ·
 * 3 det egna (medarbetarens inställningar) · 4 innehåll med källspår · 5 var det bor (fakta
 * i en rad) · 6 för IT och inköp · 7 frågor. Påståendena följer docs/TREDJEPARTER.md i appens
 * repo: aggregat från fem personer, lagras inom EU, databas i Sverige, ingen AI tränas på
 * kundernas data, inga integrationer, bara inbjudna kommer in.
 */
import FaqList from "../FaqList.astro";
import IconRow from "../IconRow.astro";
import Aggregate from "../trust/Aggregate.astro";
import Private from "../trust/Private.astro";
import SourceTrail from "../trust/SourceTrail.astro";
import { faqFor } from "../../content/faq";
import { ROUTES, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const faq = faqFor("trust", lang);
const REST = "0.5,0.5,0.1,0";
const id = sv ? { sees: "ser", own: "ditt", content: "innehallet", where: "var", it: "it" } : { sees: "sees", own: "yours", content: "content", where: "where", it: "it" };

const c = sv
  ? {
      h1: "Mönster. Aldrig personer.",
      lead: "Ledningen ser hur många som lyssnat – aldrig vilka. Det är inte en inställning någon kan ändra. Det är så produkten är byggd.",
      seesTitle: "Vad ledningen ser. Och aldrig ser.",
      seesLead: "Siffror per team, från fem personer. Under det visas ingenting.",
      yesLabel: "Ser",
      yes: ["Hur många som lyssnat, per dag och team", "Hur många som hört varje internt budskap", "Hur mycket som mindes, per team", "Vad organisationen följer, som helhet"],
      noLabel: "Ser aldrig",
      no: ["Vad en enskild person har hört", "En persons svar i quizen", "En persons egna ämnen", "Team med färre än fem personer"],
      ownTitle: "Ditt är ditt.",
      ownLead: "Det du lyssnar på, följer och svarar är ditt. Appen är byggd så att det stannar där.",
      ownIcons: [["lock", "Egna ämnen är privata"], ["mic", "Ingen mikrofon som lyssnar"], ["person", "Radera kontot själv"]],
      contentTitle: "Varje punkt har ett spår.",
      contentLead: "Branschnyheterna bygger på källor du kan läsa i recapen. Det interna kommer bara från dem ni utsett – och lyssnas igenom innan det går ut.",
      whereTitle: "Var det bor.",
      whereLead: "Kort och tråkigt, som det ska vara.",
      facts: [
        ["LAGRING", "Inom EU"],
        ["DATABAS", "Sverige"],
        ["AI-TRÄNING PÅ ERA DATA", "Nej"],
        ["INTEGRATIONER", "Inga"],
        ["VEM KOMMER IN", "Bara de ni bjuder in"],
        ["NÄR NÅGON SLUTAR", "Kontot raderas – allt försvinner"],
      ],
      itTitle: "För IT och inköp.",
      itLead: "Inget att installera, inget att koppla. Avtalen finns här.",
      docs: [
        ["PUB-avtal", "Personuppgiftsbiträdesavtalet", R.dpa],
        ["Integritetspolicy", "Hur vi hanterar personuppgifter", R.privacy],
        ["Villkor", "Det ni godkänner när ni börjar", R.terms],
      ],
      security: "Säkerhetsfrågor:",
      faqTitle: "Frågor om trygghet.",
    }
  : {
      h1: "Patterns. Never people.",
      lead: "Management sees how many listened – never who. That isn't a setting anyone can change. It's how the product is built.",
      seesTitle: "What management sees. And never sees.",
      seesLead: "Figures per team, from five people. Below that, nothing is shown.",
      yesLabel: "Sees",
      yes: ["How many listened, per day and team", "How many heard each internal message", "How much was remembered, per team", "What the organisation follows, as a whole"],
      noLabel: "Never sees",
      no: ["What an individual has heard", "A person's quiz answers", "A person's own topics", "Teams with fewer than five people"],
      ownTitle: "Yours is yours.",
      ownLead: "What you listen to, follow and answer is yours. The app is built so it stays there.",
      ownIcons: [["lock", "Own topics are private"], ["mic", "No microphone listening"], ["person", "Delete the account yourself"]],
      contentTitle: "Every story has a trail.",
      contentLead: "Industry news is built on sources you can read in the recap. Internal news only comes from the people you choose – and is listened through before it goes out.",
      whereTitle: "Where it lives.",
      whereLead: "Short and boring, as it should be.",
      facts: [
        ["STORAGE", "Within the EU"],
        ["DATABASE", "Sweden"],
        ["AI TRAINING ON YOUR DATA", "No"],
        ["INTEGRATIONS", "None"],
        ["WHO GETS IN", "Only the people you invite"],
        ["WHEN SOMEONE LEAVES", "The account is deleted – everything goes"],
      ],
      itTitle: "For IT and procurement.",
      itLead: "Nothing to install, nothing to connect. The agreements are here.",
      docs: [
        ["DPA", "The data processing agreement", R.dpa],
        ["Privacy policy", "How we handle personal data", R.privacy],
        ["Terms", "What you agree to when you start", R.terms],
      ],
      security: "Security questions:",
      faqTitle: "Questions about trust.",
    };
---

<!-- 1. Aggregatet -->
<section class="section sub-top how-hero" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack how-hero-text">
      <h1 class="title-hero">{c.h1}</h1>
      <p class="lead">{c.lead}</p>
    </div>
    <Aggregate lang={lang} />
  </div>
</section>

<!-- 2. Ser / ser aldrig -->
<section class="section full" id={id.sees} data-space data-hue="262" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.seesTitle}</h2>
      <p class="lead">{c.seesLead}</p>
    </div>
    <div class="sees">
      <div class="sees-col">
        <span class="how-mono sees-label">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          {c.yesLabel}
        </span>
        <ul class="checks">{c.yes.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="sees-col">
        <span class="how-mono sees-label">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M9.9 5.1A10.5 10.5 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4M6.2 6.2A17 17 0 0 0 2 12s3.5 7 10 7c1.3 0 2.5-.2 3.6-.6"></path></svg>
          {c.noLabel}
        </span>
        <ul class="checks no">{c.no.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<!-- 3. Ditt är ditt -->
<section class="section full" id={id.own} data-space data-hue="300" data-orb={REST} data-watch>
  <div class="split how-split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.ownTitle}</h2>
      <p class="lead">{c.ownLead}</p>
      <IconRow items={c.ownIcons as any} />
    </div>
    <div class="split-stage how-stage">
      <Private lang={lang} />
    </div>
  </div>
</section>

<!-- 4. Källspåret -->
<section class="section full" id={id.content} data-space data-hue="150" data-orb={REST} data-watch>
  <div class="split orb-left how-split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.contentTitle}</h2>
      <p class="lead">{c.contentLead}</p>
    </div>
    <div class="split-stage how-stage">
      <SourceTrail lang={lang} />
    </div>
  </div>
</section>

<!-- 5. Var det bor -->
<section class="section full" id={id.where} data-space data-hue="200" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.whereTitle}</h2>
      <p class="lead">{c.whereLead}</p>
    </div>
    <dl class="facts">
      {c.facts.map(([k, v]) => (
        <div class="fact">
          <dt class="how-mono">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- 6. För IT och inköp -->
<section class="section" id={id.it} data-space data-hue="200" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.itTitle}</h2>
      <p class="lead">{c.itLead}</p>
    </div>
    <div class="grid-3 docs">
      {
        c.docs.map(([t, d, href]) => (
          <a class="tile" href={href}>
            <span class="doc-ico" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg>
            </span>
            <span><b>{t}</b><small>{d}</small></span>
          </a>
        ))
      }
    </div>
    <p class="note">{c.security} <a href="mailto:hello@newstail.io">hello@newstail.io</a></p>
  </div>
</section>

<!-- 7. Frågor -->
<section class="section" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="faq-split">
    <div class="stack">
      <h2 class="title-xl">{c.faqTitle}</h2>
      <a class="link-more" href={R.faq}>{ui.allQuestions}</a>
    </div>
    <FaqList items={faq} lang={lang} />
  </div>
</section>
