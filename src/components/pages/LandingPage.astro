---
/**
 * Mallen för alla landningssidor (2026-10-28, i sajtens nya grammatik): hero med telefonen,
 * (guidens artikel), känner ni igen er (linjer), så funkar det för er (tre rader med varsin
 * bild), så kan det låta (tre kort ur sändningen – inget ljud), (jämförelsen), frågor,
 * läs vidare och avslut. Allt kommer ur en Landing i src/content/landings-*.ts.
 */
import Phone from "../air/Phone.astro";
import ScreenPlayer from "../air/ScreenPlayer.astro";
import FaqList from "../FaqList.astro";
import RowVisual from "../landing/RowVisual.astro";
import type { Landing } from "../../content/landing-types";
import { CLUSTERS, resolveRelated } from "../../content/landings";
import { ROUTES, START_URL, UI } from "../../content/site";

interface Props {
  l: Landing;
}
const { l } = Astro.props;
const ui = UI.sv;
const R = ROUTES.sv;
const cl = CLUSTERS[l.cluster];
const REST = "0.5,0.5,0.1,0";
const HUE: Record<string, number> = { INTERNT: 72, "NÅGOT NYTT": 300, BRANSCH: 200, MARKNAD: 150, KUNDER: 262, KONKURRENTER: 350 };
const hueOf = (topic: string) => HUE[topic.toUpperCase()] ?? 200;
const related = l.related.map(resolveRelated).filter((x) => x !== null);
---

<div class={l.article ? "flow" : undefined}>
<!-- 1. Hero -->
<section class="section sub-top" data-space data-hue={String(hueOf(l.phone.topic))} data-orb={REST} data-watch>
  <div class="split how-split">
    <div class="split-text stack">
      <nav class="crumbs" aria-label="Brödsmulor">
        <a href="/">Newstail</a><span aria-hidden="true">›</span><a href={`/${l.cluster}/`}>{cl.name}</a>
      </nav>
      <h1 class="title-hero landing-h1">{l.h1}</h1>
      <p class="lead">{l.lead}</p>
      <div class="actions">
        <a class="pill pill-primary pill-lg" href={START_URL}>{ui.startLong}</a>
        <a class="link-more" href={R.how}>{ui.nav.how}</a>
      </div>
      <p class="note">{ui.noCard}</p>
    </div>
    <div class="split-stage stage-device stage-glow" style={`--glow-hue: ${hueOf(l.phone.topic)}`}>
      <Phone label="Sändningen i Newstail-appen">
        <ScreenPlayer items={[{ ...l.phone, hue: hueOf(l.phone.topic) }]} />
      </Phone>
    </div>
  </div>
</section>

<!-- 2. Guidens artikel -->
{
  l.article && (
    <section class="section section-auto" data-space data-hue="200" data-orb={REST}>
      <article class="article">
        <p class="answer">{l.article.answer}</p>
        {l.article.sections.map((s) => (
          <section>
            <h2>{s.h}</h2>
            <p>{s.p}</p>
            {s.list && (
              <ol>
                {s.list.map((x) => (
                  <li>{x}</li>
                ))}
              </ol>
            )}
          </section>
        ))}
      </article>
    </section>
  )
}

<!-- 3. Känner ni igen er? -->
<section class="section" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">Känner ni igen er?</h2>
    </div>
    <div class="grid-3 land-pains">
      {l.pains.map((p) => <div class="lined"><strong>{p.t}</strong><span>{p.d}</span></div>)}
    </div>
  </div>
</section>

<!-- 4. Så funkar det för er: tre rader -->
<section class="section land-rows" data-space data-hue="150" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">Så funkar det för er.</h2>
    </div>
    <div class="land-rowlist">
      {l.rows.map((r, i) => (
        <div class={`split how-split land-row${i % 2 ? " orb-left" : ""}`}>
          <div class="split-text stack">
            <h3 class="title-lg">{r.t}</h3>
            <p class="lead">{r.d}</p>
          </div>
          <div class="split-stage how-stage">
            <RowVisual v={r.visual} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 5. Så kan det låta -->
<section class="section" id="exempel" data-space data-hue="300" data-orb={REST} data-watch>
  <div class="split how-split">
    <div class="split-text stack">
      <h2 class="title-xl">Så kan det låta hos er.</h2>
      <p class="lead">Tre punkter ur en sändning – med värdens ord, på det språk var och en valt.</p>
    </div>
    <div class="split-stage how-stage">
      <div class="after land-script" data-watch role="img" aria-label="Tre punkter ur en sändning">
        {l.script.map((s, i) => (
          <div class={`after-card${s.topic.toUpperCase() === "INTERNT" ? " is-inside" : ""}`} style={`--i: ${i}`}>
            <small class="after-k">{s.topic}</small>
            <p>{s.t}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- 6. Jämförelsen -->
{
  l.compare && l.compare.rows.length > 0 && (
    <section class="section" data-space data-hue="200" data-orb={REST} data-watch>
      <div class="wide">
        <div class="wide-head stack">
          <h2 class="title-xl">Newstail och {l.compare.other}.</h2>
        </div>
        <table class="compare">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Egenskap</span></th>
              <th scope="col">Newstail</th>
              <th scope="col">{l.compare.other}</th>
            </tr>
          </thead>
          <tbody>
            {l.compare.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.newstail}</td>
                <td>{r.other}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note">{l.compare.fair}</p>
      </div>
    </section>
  )
}

<!-- 7. Frågor -->
<section class="section" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="faq-split">
    <div class="stack">
      <h2 class="title-xl">Frågor.</h2>
      <a class="link-more" href="/fragor/">{ui.allQuestions}</a>
    </div>
    <FaqList items={l.faq} lang="sv" />
  </div>
</section>

<!-- 8. Läs vidare -->
<section class="section" data-space data-hue="200" data-orb={REST} data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">Läs vidare.</h2>
    </div>
    <div class="grid-3 land-more">
      {
        related.map((r) => (
          <a class="lined lined-link" href={r!.href}>
            <small class="how-mono">{r!.cluster}</small>
            <strong>{r!.name}</strong>
            <span>{r!.card}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- 9. Avslut -->
<section class="section closing" data-space data-hue="200" data-orb={REST} data-watch>
  <div class="stack closing-text">
    <h2 class="title-xl">Prova med hela företaget.</h2>
    <ul class="how-meta end-meta" aria-hidden="true">
      <li>14 dagar gratis</li>
      <li>Inget kort</li>
      <li>Ingen bindning</li>
    </ul>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{ui.startLong}</a>
      <a class="pill pill-secondary pill-lg" href={R.pricing}>Se priser</a>
    </div>
  </div>
</section>
</div>
