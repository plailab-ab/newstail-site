---
/**
 * iPhone ritad i HTML (2026-10-26, verkligare): titanram med ljuskant, sidoknappar, djup
 * skugga och glas. Ramen och skärmen är fasta 380×800 px och skalas till omslagets bredd
 * (Base: .dev + --s). Skärmarna i ./Screen*.astro läggs i sloten.
 */
interface Props {
  class?: string;
  label: string;
  /** Svag, mindre telefon bakom en annan. */
  back?: boolean;
  /** Genomskinlig skärm – rymden (och klotet) bakom syns igenom. Används i scenen. */
  clear?: boolean;
}
const { class: cls = "", label, back = false, clear = false } = Astro.props;
---

<div class={`dev aphone${back ? " aphone-back" : ""}${clear ? " aphone-clear" : ""} ${cls}`} style="--w: 380; --h: 800" role="img" aria-label={label}>
  <div class="aphone-body">
    <span class="aphone-btn aphone-btn-mute" aria-hidden="true"></span>
    <span class="aphone-btn aphone-btn-up" aria-hidden="true"></span>
    <span class="aphone-btn aphone-btn-down" aria-hidden="true"></span>
    <span class="aphone-btn aphone-btn-power" aria-hidden="true"></span>
    <div class="aphone-screen">
      <slot />
      <span class="aphone-island" aria-hidden="true"></span>
      <span class="aphone-time" aria-hidden="true">9:41</span>
      <span class="aphone-status" aria-hidden="true">
        <svg width="18" height="12" viewBox="0 0 18 12" fill="#eceff4"><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg>
        <svg width="26" height="13" viewBox="0 0 26 13" fill="none"><rect x="0.5" y="0.5" width="22" height="12" rx="3.5" stroke="#eceff4" stroke-opacity=".45"></rect><rect x="2.5" y="2.5" width="18" height="8" rx="2" fill="#eceff4"></rect></svg>
      </span>
      <span class="aphone-glass" aria-hidden="true"></span>
      <span class="aphone-home" aria-hidden="true"></span>
    </div>
  </div>
</div>
