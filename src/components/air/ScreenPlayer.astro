---
/**
 * Sändningen som i appen 2026-10-23: bara klotet med progressringen, prickarna ovanför,
 * ämne (grått, versaler) + rubrik (vit) + källor (grått) under, hand-ikonen uppe till höger
 * och "Avsluta" som ren text längst ner. Inga knappar – tryck = paus, svep = nästa, håll = berätta mer.
 * Med flera punkter byter den själv, som när värden går vidare.
 */
export type PlayerItem = { topic: string; title: string; src: string; hue: number; inside?: boolean };
interface Props {
  items: PlayerItem[];
  /** Vilken punkt som syns först. */
  start?: number;
  done?: string;
}
const { items, start = 0, done = "Avsluta" } = Astro.props;
const first = items[start]!;
---

<div class={`scr-player${first.inside ? " is-inside" : ""}`} data-player data-items={JSON.stringify(items)} data-start={start} style={`--hue: ${first.hue}`}>
  <span class="scr-btn scr-btn-tr" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eceff4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 14a8 8 0 0 1-8 8h-1.5a6.5 6.5 0 0 1-5.2-2.6L3.7 14.3a2 2 0 0 1 3-2.6L9 14V5a2 2 0 1 1 4 0v5a2 2 0 1 1 4 0v1a2 2 0 1 1 4 0z"></path></svg></span>
  <div class="scr-dots" aria-hidden="true">
    {items.map((_, i) => <span class={i === start ? "is-on" : ""} />)}
  </div>
  <div class="scr-orb-wrap">
    <span class="scr-orb-glow" aria-hidden="true"></span>
    <span class="scr-ring" aria-hidden="true"></span>
    <span class="scr-ring-arc" aria-hidden="true"></span>
    <img class="scr-orb" src={`/orbs/orb-${first.hue}.webp`} alt="" width="240" height="240" loading="lazy" decoding="async" />
  </div>
  <div class="scr-caption">
    <span class="scr-topic" data-p-topic>{first.topic}</span>
    <span class="scr-title" data-p-title>{first.title}</span>
    <span class="scr-src" data-p-src>{first.src}</span>
  </div>
  <span class="scr-done">{done}</span>
</div>

<script>
  // Punkterna byter som när värden går vidare: ringen fylls, tonar, börjar om.
  document.querySelectorAll<HTMLElement>("[data-player]").forEach((el) => {
    const items = JSON.parse(el.dataset.items || "[]") as { topic: string; title: string; src: string; hue: number; inside?: boolean }[];
    if (items.length < 2) return;
    const topic = el.querySelector<HTMLElement>("[data-p-topic]")!;
    const title = el.querySelector<HTMLElement>("[data-p-title]")!;
    const src = el.querySelector<HTMLElement>("[data-p-src]")!;
    const orb = el.querySelector<HTMLImageElement>(".scr-orb")!;
    const dots = [...el.querySelectorAll<HTMLElement>(".scr-dots span")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let i = Number(el.dataset.start || 0);
    let timer = 0;
    items.forEach((x) => {
      const im = new Image();
      im.src = `/orbs/orb-${x.hue}.webp`;
    });
    const show = (k: number) => {
      const x = items[k]!;
      el.classList.add("is-switching");
      window.setTimeout(() => {
        topic.textContent = x.topic;
        title.textContent = x.title;
        src.textContent = x.src;
        orb.src = `/orbs/orb-${x.hue}.webp`;
        dots.forEach((d, j) => d.classList.toggle("is-on", j === k));
        el.style.setProperty("--hue", String(x.hue));
        el.classList.toggle("is-inside", !!x.inside);
        el.classList.remove("is-switching");
        el.classList.remove("is-running");
        void el.offsetWidth;
        el.classList.add("is-running");
      }, 260);
    };
    const run = () => {
      if (timer || reduced) return;
      el.classList.add("is-running");
      timer = window.setInterval(() => {
        i = (i + 1) % items.length;
        show(i);
      }, 4600);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? run() : stop()), { threshold: 0.4 }).observe(el);
  });
</script>
