---
/**
 * Scenen (2026-10-26): en skärm som går från hemvyn till sändningen medan man scrollar.
 * Klotet är inte ritat här – det är sajtens riktiga WebGL-klot (Space) som följer ankaret
 * [data-orb-anchor]; skärmen är genomskinlig (Phone clear). Sektionen sätter klasserna
 * s-home / s-drag / s-play, data-item (0–2) och variablerna --rise (0–1) och --ring (0–100).
 */
import type { HomeItem } from "./ScreenHome.astro";
export type SceneItem = { topic: string; title: string; src: string; hue: number; inside?: boolean };
interface Props {
  company: string;
  greeting: string;
  date: string;
  bubbles: HomeItem[];
  items: SceneItem[];
  recap?: string;
  done?: string;
}
const { company, greeting, date, bubbles, items, recap = "Recap", done = "Avsluta" } = Astro.props;
---

<div class="scr-scene">
  <!-- Hemvyn -->
  <div class="sc-home">
    <div class="scr-hd">
      <span class="scr-btn" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eceff4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="13" rx="3"></rect><path d="M5 10a7 7 0 0 0 14 0M12 19v3M8 22h8"></path></svg></span>
      <span class="scr-company">{company}</span>
      <span class="scr-avatar" aria-hidden="true"><img src="/avatar-anna.webp" alt="" width="50" height="50" loading="lazy" decoding="async" /></span>
    </div>
    <span class="scr-h1">{greeting}</span>
    <span class="scr-date">{date}</span>
    <span class="scr-pill scr-pill-recap">{recap}</span>
    <div class="scr-bubbles">
      {
        bubbles.map((x, i) => (
          <span class={`scr-bubble scr-bubble-${i % 2 ? "l" : "r"} k-${x.kind}`} style={`--i: ${i}`}>
            <small>{x.label}</small>
            {x.title}
          </span>
        ))
      }
    </div>
    <span class="scr-nudge" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#9ba7b7" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6"></path></svg></span>
  </div>

  <!-- Draget: spåret upp till målringen -->
  <div class="sc-rail" aria-hidden="true">
    <span class="sc-rail-line"></span>
    <span class="sc-rail-target"></span>
  </div>

  <!-- Sändningen -->
  <div class="sc-play">
    <span class="scr-btn scr-btn-tr" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#eceff4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 14a8 8 0 0 1-8 8h-1.5a6.5 6.5 0 0 1-5.2-2.6L3.7 14.3a2 2 0 0 1 3-2.6L9 14V5a2 2 0 1 1 4 0v5a2 2 0 1 1 4 0v1a2 2 0 1 1 4 0z"></path></svg></span>
    <div class="scr-dots" aria-hidden="true">
      {items.map((_, i) => <span data-dot={i} />)}
    </div>
    <div class="scr-orb-wrap sc-ring-wrap">
      <span class="scr-ring" aria-hidden="true"></span>
      <span class="scr-ring-arc" aria-hidden="true"></span>
    </div>
    <div class="scr-caption sc-captions">
      {items.map((x, i) => (
        <span class={`sc-cap${x.inside ? " is-inside" : ""}`} data-cap={i}>
          <span class="scr-topic">{x.topic}</span>
          <span class="scr-title">{x.title}</span>
          <span class="scr-src">{x.src}</span>
        </span>
      ))}
    </div>
    <span class="scr-done">{done}</span>
  </div>

  <!-- Klotets ankare: vilan nere, glider upp och växer med --rise -->
  <span class="sc-anchor" data-orb-anchor aria-hidden="true"></span>
</div>
