---
/**
 * Aggregatet (2026-10-27): 41 personer blir ett tal. Punkterna tänds en i taget när bilden
 * kommer i bild och strålar in mot talet "34 av 41". Hela poängen med Trygghet i en bild.
 */
interface Props {
  lang: "sv" | "en";
}
const { lang } = Astro.props;
const sv = lang === "sv";
const N = 41;
const on = new Set([0, 1, 2, 4, 5, 6, 7, 8, 9, 10, 12, 13, 14, 15, 17, 18, 19, 20, 21, 23, 24, 25, 26, 27, 28, 30, 31, 33, 34, 35, 36, 37, 39, 40]);
const W = 760;
const H = 360;
// Personerna i en lös svärm till vänster, deterministiskt utspridda.
const people = Array.from({ length: N }, (_, i) => {
  const col = i % 7;
  const row = Math.floor(i / 7);
  const jx = ((i * 37) % 11) - 5;
  const jy = ((i * 53) % 9) - 4;
  return { x: 60 + col * 44 + jx, y: 70 + row * 46 + jy, on: on.has(i), i };
});
const TX = 600;
const TY = 190;
---

<svg class="aggr" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={sv ? "41 personer blir talet 34 av 41" : "41 people become the figure 34 of 41"}>
  <defs>
    <linearGradient id="ag-ray" x1="0" x2="1"><stop offset="0" stop-color="#eceff4" stop-opacity="0"></stop><stop offset="1" stop-color="#eceff4" stop-opacity="0.35"></stop></linearGradient>
  </defs>
  <!-- strålarna in mot talet -->
  {people.filter((p) => p.on).map((p) => <line class="ag-ray" x1={p.x} y1={p.y} x2={TX - 86} y2={TY} style={`--i: ${p.i}`} />)}
  <!-- personerna -->
  {people.map((p) => <circle class={`ag-dot${p.on ? " is-on" : ""}`} cx={p.x} cy={p.y} r="6" style={`--i: ${p.i}`} />)}
  <text class="ag-mono" x="60" y="34">{sv ? "41 PERSONER · TRE TEAM" : "41 PEOPLE · THREE TEAMS"}</text>
  <!-- talet -->
  <rect x={TX - 90} y={TY - 62} width="190" height="124" rx="18" fill="#0d0e11" stroke="rgba(236,239,244,0.14)"></rect>
  <text class="ag-mono" x={TX - 70} y={TY - 36}>{sv ? "HAR LYSSNAT · I DAG" : "HAVE LISTENED · TODAY"}</text>
  <text class="ag-big" x={TX - 70} y={TY + 14}>34</text>
  <text class="ag-of" x={TX - 6} y={TY + 14}>{sv ? "av 41" : "of 41"}</text>
  <text class="ag-sub" x={TX - 70} y={TY + 44}>{sv ? "Hur många. Aldrig vilka." : "How many. Never who."}</text>
</svg>
