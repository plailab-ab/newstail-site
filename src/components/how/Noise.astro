---
/**
 * Bruset (2026-10-27): rader av rubriker på olika språk, från olika källor, publicerade vid
 * olika tider, som driver förbi i olika takt. Den enda bilden på sajten som får vara stökig –
 * med flit. Bara transform animeras (billigt för kompositorn); stilla med reduced motion.
 */
interface Props {
  lang: "sv" | "en";
  /** Två rader i stället för fyra (startsidan). */
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
type Item = [string, string, string, string]; // tid, källa, språk, rubrik
const rows: Item[][] = [
  [
    ["03:12", "Northwire", "EN", "Central bank signals slower pace of cuts"],
    ["06:40", "Näringsliv Idag", "SV", "Marknaden räknar med sänkning före jul"],
    ["07:05", "Wirtschaft Nord", "DE", "Baukosten steigen zum dritten Quartal in Folge"],
    ["08:30", "Fastighetsbladet", "SV", "Vakanserna minskar i Smålands kontorsmarknad"],
    ["09:10", "Mercado Hoy", "ES", "El alquiler de oficinas repunta en Madrid"],
    ["11:45", "Market Post", "EN", "European REITs rally on rate hopes"],
  ],
  [
    ["04:50", "Boverket", "SV", "Nya krav på energideklarationer från årsskiftet"],
    ["05:20", "Le Journal Éco", "FR", "Immobilier : les taux repartent à la baisse"],
    ["07:55", "Morgonbladet", "SV", "Byggstarterna på lägsta nivån sedan 2012"],
    ["10:15", "Capital Desk", "EN", "Nordic property deals pick up in Q3"],
    ["12:00", "Vätterbygdens Tidning", "SV", "1 200 bostäder planeras vid Munksjön"],
    ["14:20", "Immobilien Heute", "DE", "Leerstand in Büroimmobilien sinkt leicht"],
  ],
  [
    ["02:30", "Pacific Markets", "EN", "Timber prices ease after record year"],
    ["06:05", "Energimyndigheten", "SV", "Solceller på taken: nya stödregler för flerbostadshus"],
    ["08:45", "La Crónica", "ES", "La banca prevé más hipotecas a tipo fijo"],
    ["09:40", "Riksbanken", "SV", "Protokoll från det penningpolitiska mötet"],
    ["13:10", "The Daily Review", "EN", "Cities rethink office space after hybrid work"],
    ["16:30", "Smålandsnytt", "SV", "HV71 vände och vann i Linköping"],
  ],
  [
    ["01:15", "Newswire", "EN", "Interest-rate decision expected Thursday"],
    ["06:20", "Sydposten", "SV", "Hyrorna höjs 3,2 procent i Småland"],
    ["07:30", "Tagesmarkt", "DE", "Wohnungsbau: Genehmigungen gehen weiter zurück"],
    ["10:50", "Diario Económico", "ES", "Las socimis ganan atractivo con la bajada de tipos"],
    ["15:00", "Näringsliv Idag", "SV", "Fastighetsbolagen refinansierar till lägre ränta"],
    ["17:40", "Northwire", "EN", "Energy efficiency rules tighten across the EU"],
  ],
];
const label = lang === "sv" ? "Ett dygn av nyheter som rör ett fastighetsbolag i Jönköping – en bråkdel." : "One day of news that concerns a property company in Jönköping – a fraction.";
---

<div class={`noise${compact ? " noise-compact" : ""}`} role="img" aria-label={label}>
  {(compact ? rows.slice(0, 2) : rows).map((row, r) => (
    <div class={`noise-row noise-row-${r}`} style={`--r: ${r}`}>
      {[...row, ...row].map(([t, src, lg, h]) => (
        <span class="noise-item">
          <small>{t} · {src} · {lg}</small>
          {h}
        </span>
      ))}
    </div>
  ))}
  <span class="noise-fade noise-fade-l" aria-hidden="true"></span>
  <span class="noise-fade noise-fade-r" aria-hidden="true"></span>
</div>
