---
import Base from "../layouts/Base.astro";
import TrustPage from "../components/pages/TrustPage.astro";
import { breadcrumbs, faqPage } from "../content/site";
import { faqFor } from "../content/faq";
---

<Base
  lang="sv"
  path="/trygghet/"
  altPath="/en/trust/"
  title="Trygghet – vad ledningen ser och aldrig ser | Newstail"
  description="Ledningen ser mönster per team, aldrig vad en enskild medarbetare hört. Databas i EU, ingen AI-träning på era data, integritetspolicy och PUB-avtal."
  snap
  schema={[breadcrumbs([{ name: "Newstail", path: "/" }, { name: "Trygghet", path: "/trygghet/" }]), faqPage(faqFor("trust", "sv"))]}
>
  <TrustPage lang="sv" />
</Base>
