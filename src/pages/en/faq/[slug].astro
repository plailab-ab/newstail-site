---
import Base from "../../../layouts/Base.astro";
import FaqQuestion from "../../../components/pages/FaqQuestion.astro";
import { CATS, FAQ, faqMeta, faqPath, type Faq } from "../../../content/faq";
import { breadcrumbs, faqPage } from "../../../content/site";

export function getStaticPaths() {
  return FAQ.map((faq) => ({ params: { slug: faq.slug.en }, props: { faq } }));
}
const { faq } = Astro.props as { faq: Faq };
const path = faqPath("en", faq.slug.en);
---

<Base
  lang="en"
  path={path}
  altPath={faqPath("sv", faq.slug.sv)}
  title={faqMeta(faq, "en").title}
  description={faqMeta(faq, "en").description}
  schema={[
    breadcrumbs([
      { name: "Newstail", path: "/en/" },
      { name: "Questions", path: "/en/faq/" },
      { name: CATS[faq.cat].en, path: `/en/faq/#${faq.cat}` },
      { name: faq.en.q, path },
    ]),
    faqPage([faq.en]),
  ]}
>
  <FaqQuestion lang="en" faq={faq} />
</Base>
