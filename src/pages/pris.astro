---
import Base from "../layouts/Base.astro";
import PricingPage from "../components/pages/PricingPage.astro";
import { breadcrumbs, faqPage } from "../content/site";
import { faqFor } from "../content/faq";
---

<Base
  lang="sv"
  path="/pris/"
  altPath="/en/pricing/"
  title="Pris – 179 kr per användare och månad | Newstail"
  description="Ett pris: 179 kr per användare och månad, allt ingår. Tio användare ingår, ingen bindning, 14 dagar gratis."
  snap
  schema={[breadcrumbs([{ name: "Newstail", path: "/" }, { name: "Pris", path: "/pris/" }]), faqPage(faqFor("pricing", "sv"))]}
>
  <PricingPage lang="sv" />
</Base>
