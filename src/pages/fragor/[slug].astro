---
import Base from "../../layouts/Base.astro";
import FaqQuestion from "../../components/pages/FaqQuestion.astro";
import { CATS, FAQ, faqMeta, faqNoindex, faqPath, type Faq } from "../../content/faq";
import { breadcrumbs, faqPage } from "../../content/site";

export function getStaticPaths() {
  return FAQ.map((faq) => ({ params: { slug: faq.slug.sv }, props: { faq } }));
}
const { faq } = Astro.props as { faq: Faq };
const path = faqPath("sv", faq.slug.sv);
---

<Base
  lang="sv"
  path={path}
  altPath={faqPath("en", faq.slug.en)}
  title={faqMeta(faq, "sv").title}
  description={faqMeta(faq, "sv").description}
  noindex={faqNoindex(faq)}
  schema={[
    breadcrumbs([
      { name: "Newstail", path: "/" },
      { name: "Frågor", path: "/fragor/" },
      { name: CATS[faq.cat].sv, path: `/fragor/#${faq.cat}` },
      { name: faq.sv.q, path },
    ]),
    faqPage([faq.sv]),
  ]}
>
  <FaqQuestion lang="sv" faq={faq} />
</Base>
